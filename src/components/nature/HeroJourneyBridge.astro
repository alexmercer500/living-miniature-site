---
import Art from './Art.astro';
import Foliage from '../scene/Foliage.astro';
import CameraFlourish from './CameraFlourish.astro';
import { landscapes } from '../../lib/nature-assets';
---
<!-- Decorative camera only. Original sections own all text, focus and anchors. -->
<div class="ns-journey-bridge" data-journey-bridge aria-hidden="true" inert>
  <div class="ns-bridge-outgoing"><Art {...landscapes.hero} /></div>
  <div class="ns-bridge-incoming"><div class="ns-bridge-incoming-camera"><Art {...landscapes.journey} /></div></div>
  <CameraFlourish />
  <div class="ns-bridge-shade"></div>
  <div class="ns-bridge-bough left"><Foliage side="left" variant="b" /></div>
  <div class="ns-bridge-bough right"><Foliage side="right" variant="a" /></div>
</div>
