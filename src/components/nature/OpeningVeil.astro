---
/**
 * A short opening veil over the home page's first paint: the welcome painting itself,
 * out of focus at dusk (its inline blurred preview), with drifting lantern light.
 * It lifts once the painting is decoded and the hero's fonts are in (or, on a #section
 * link, once the page has scrolled there), and after 3.5s regardless, so guests never
 * watch the page assemble itself. Skipped on revisits in the same tab, and without JS.
 */
import LotusMark from '../LotusMark.astro';
import Monogram from '../Monogram.astro';
interface Props { scene?: string; sceneWide?: string; greeting?: string }
const { scene, sceneWide, greeting } = Astro.props;
const style = [scene && `--veil-scene: ${scene}`, sceneWide && `--veil-scene-wide: ${sceneWide}`].filter(Boolean).join('; ') || undefined;
// Fixed positions, sizes and timings, so every build and every visit looks the same.
const motes = [[18, 72, 16, 7.5, 0, 14], [33, 86, 10, 6.2, .7, -10], [47, 64, 22, 8.4, .3, 8], [61, 80, 12, 6.8, 1.2, -16],
  [74, 70, 18, 7.8, .5, 12], [86, 88, 11, 6.4, 1, -8], [9, 92, 14, 7.2, 1.5, 10], [55, 95, 19, 8.8, .9, -12], [26, 58, 10, 6.6, 1.8, 6]];
---
<div class="ns-veil" aria-hidden="true" style={style}>
  <div class="ns-veil-scene"></div>
  <div class="ns-veil-motes">{motes.map(([x, y, size, duration, delay, dx]) =>
    <i style={`--x:${x}%;--y:${y}%;--s:${size}px;--d:${duration}s;--delay:${delay}s;--dx:${dx}px;--a:${size > 15 ? .6 : .9}`}></i>)}</div>
  <div class="ns-veil-mark"><LotusMark class="ns-veil-lotus" /><Monogram /><span class="ns-veil-line"></span>
    <p class="ns-veil-greeting" data-template={greeting} hidden></p><script is:inline>window.nsGreet?.(document.currentScript.previousElementSibling)</script></div>
</div>
<script is:inline>
  (() => {
    const html = document.documentElement;
    const lift = () => {
      if ('natureLoaded' in html.dataset) return;
      html.dataset.natureLoaded = '';
      try { sessionStorage.setItem('ns-veil', '1'); } catch { /* private mode: show it again next time */ }
      // Once it has faded, take it out of rendering: its drifting motes would otherwise
      // keep animating unseen for the whole visit.
      setTimeout(() => { const veil = document.querySelector('.ns-veil'); if (veil) veil.hidden = true; }, 1600);
    };
    let seen = false;
    try { seen = sessionStorage.getItem('ns-veil') === '1'; } catch { /* storage blocked */ }
    if (seen) return lift();
    setTimeout(lift, 3500);
    document.addEventListener('DOMContentLoaded', () => {
      const hero = document.getElementById('welcome');
      let target = null;
      try { target = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1))); } catch { /* malformed hash */ }
      const deepLink = target && target !== hero;
      // A #section link waits for the home script to settle the scroll position there.
      const settled = deepLink ? new Promise(resolve => {
        if ('natureReady' in html.dataset) return resolve();
        const watch = new MutationObserver(() => { if ('natureReady' in html.dataset) { watch.disconnect(); resolve(); } });
        watch.observe(html, { attributes: true, attributeFilter: ['data-nature-ready'] });
      }) : hero?.querySelector('img')?.decode().catch(() => {});
      // Load exactly the faces the hero's words use, so the names never swap typeface on screen.
      const fonts = [...(hero?.querySelectorAll('.ns-hero-copy :is(p, h1 > *)') ?? [])].map(el => {
        const style = getComputedStyle(el);
        return document.fonts?.load(`${style.fontStyle} ${style.fontWeight} 16px ${style.fontFamily}`, el.textContent || undefined).catch(() => {});
      });
      Promise.all([settled, ...fonts]).then(lift);
    }, { once: true });
  })();
</script>
