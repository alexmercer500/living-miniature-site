---
import { getImage } from 'astro:assets';
import { type Lang, content, loc, href, t, formatDate } from '../../lib/content';
import LotusMark from '../LotusMark.astro';
import Icon from '../Icon.astro';
import paper from '../../assets/nature-stories/ivory-floral-paper-v1.png';

/** The letter chapter: an envelope on the garden table that opens as the guest scrolls. The backdrop slot holds the scene art. */
interface Props { lang: Lang; id?: string; invitationHref?: string; continueHref?: string }
const { lang, id = 'invitation', invitationHref = href(lang, '/invitation'), continueHref = '#celebrations' } = Astro.props;
const paperMaterial = await getImage({ src: paper, width: 1024, format: 'webp', quality: 80 });
const date = formatDate(content.site.weddingDate, lang, true) ?? loc(content.site.weddingDateLabel, lang);
const [one, two] = loc(content.couple.displayName, lang).split(lang === 'hi' ? ' एवं ' : ' & ');
---
<section id={id} class="envelope-scene" data-envelope aria-labelledby="envelope-title"
  style={`--paper-material: url('${paperMaterial.src}')`}>
  <div class="envelope-viewport ns-scene">
    <div class="envelope-backdrop" aria-hidden="true">
      <slot name="backdrop" />
    </div>
    <header class="envelope-heading">
      <p class="eyebrow">{t(lang, 'invitation')}</p>
      <h2 id="envelope-title">{t(lang, 'envelopeHeading')}</h2>
      <p class="envelope-hint" data-envelope-hint hidden>{t(lang, 'envelopeHint')}</p>
    </header>

    <div class="table-contact-shadow" aria-hidden="true"></div>
    <div class="envelope-aura" aria-hidden="true"></div>
    <div class="envelope-rig">
      <div class="envelope-back" aria-hidden="true"></div>
      <div class="envelope-lining" aria-hidden="true"></div>
      <div class="envelope-flap" aria-hidden="true"><div></div></div>

      <article id="invitation-card" class="invitation-card" data-envelope-card aria-labelledby="invitation-card-title">
        <LotusMark class="card-mark" />
        <h3 id="invitation-card-title"><span class="name-one">{one}</span><em>{lang === 'hi' ? 'एवं' : '&'}</em><span class="name-two">{two}</span></h3>
        <p class="card-date">{date}</p>
        <p class="card-venue">{content.venue.name}</p>
        <a class="card-link" href={invitationHref}>{loc(content.invitation.label, lang)} <Icon name="arrow-right" /></a>
      </article>

      <div class="envelope-pocket" aria-hidden="true"></div>
      <svg class="envelope-seams" viewBox="0 0 600 375" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M1 1L300 198L599 1 M1 374L211 140 M599 374L389 140" />
      </svg>
      <button class="seal-control" type="button" data-envelope-toggle hidden
        aria-controls="invitation-card" aria-expanded="true"
        aria-label={t(lang, 'openEnvelope')}
        data-label-open={t(lang, 'openEnvelope')} data-label-close={t(lang, 'closeEnvelope')}>
        <span class="wax-seal" aria-hidden="true"><LotusMark /></span>
        <span class="visually-hidden" data-envelope-label>{t(lang, 'openEnvelope')}</span>
      </button>
    </div>

    <div class="envelope-footer">
      <a href={invitationHref}>{loc(content.invitation.label, lang)}</a>
      <a href={continueHref}>{t(lang, 'continueJourney')} <Icon name="arrow-down" /></a>
    </div>
    <p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-envelope-status
      data-open={t(lang, 'envelopeOpened')} data-closed={t(lang, 'envelopeClosed')}></p>
  </div>
</section>

<style>
  .envelope-scene {
    --seal-opacity: 0;
    --seal-lift: -3rem;
    --flap-angle: -180deg;
    --flap-layer: 1;
    --card-rise: -25%;
    --card-mask: 0%;
    --card-opacity: 1;
    --rig-angle: 0deg;
    --rig-top: 50%;
    --rig-scale: 1;
    --rig-roll: 0deg;
    --rig-shadow: 32px;
    --card-layer: 6;
    --card-scale: 1.05;
    --card-turn: 0deg;
    --table-shadow-opacity: .14;
    --table-shadow-scale: .55;
    --heading-opacity: 0;
    --control-top: 40%;
    --aura-opacity: .35;
    --sheen-position: 140%;
    --sheen-opacity: 0;
    position: relative;
    background: #172e28;
    isolation: isolate;
  }
  .envelope-viewport { position: relative; height: var(--ns-screen, 100svh); overflow: clip; }
  [data-enhanced] .envelope-viewport { position: sticky; top: 0; }
  .envelope-backdrop { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .envelope-backdrop::after { content: ''; position: absolute; inset: 0; background: var(--ns-shade-invitation); }
  .envelope-heading {
    position: relative; z-index: 2; text-align: center;
    padding: calc(var(--header-h) + 1.5rem) var(--gutter) 0;
    color: #fff1d8; text-shadow: 0 2px 12px #21140f;
    opacity: var(--heading-opacity);
  }
  .envelope-heading .eyebrow { color: #e6c27b; }
  .envelope-heading h2 { margin-top: .5rem; font-size: clamp(1.7rem, 4vw, 3rem); }
  .envelope-hint { margin-top: .6rem; font-size: .9rem; }
  [hidden] { display: none !important; }
  .envelope-rig {
    position: absolute; z-index: 2; top: var(--rig-top); left: 50%; width: min(87vw, 35rem); aspect-ratio: 1.6;
    translate: -50% -50%;
    transform-origin: 50% 50%;
    transform: perspective(1600px) rotateX(var(--rig-angle)) rotateZ(var(--rig-roll)) scale(var(--rig-scale));
    filter: drop-shadow(0 var(--rig-shadow) var(--rig-shadow) rgb(15 6 3 / .5));
  }
  .table-contact-shadow {
    position: absolute; left: 50%; top: 69%; width: min(76vw, 31rem); height: clamp(2rem, 8vw, 5rem);
    translate: -50% -50%; transform: scale(var(--table-shadow-scale));
    opacity: var(--table-shadow-opacity); pointer-events: none;
    background: radial-gradient(ellipse, #160703 0%, #16070399 38%, transparent 72%);
  }
  .envelope-aura {
    position: absolute; inset: 22% 8% 10%; pointer-events: none;
    background: radial-gradient(ellipse, #ffd38a55 0%, #c48a3933 28%, transparent 67%);
    opacity: var(--aura-opacity); mix-blend-mode: screen;
  }
  .envelope-back, .envelope-lining, .envelope-pocket, .envelope-flap { position: absolute; inset: 0; border-radius: 3px; }
  .envelope-back, .envelope-pocket, .envelope-flap > div, .invitation-card {
    background-color: #f2d9af; background-image: var(--paper-material); background-size: 100% 100%;
  }
  .envelope-back { z-index: 0; box-shadow: 0 3px 0 #bf985f, 0 5px 0 #815c35; }
  .envelope-lining { z-index: 1; inset: 2%; background: linear-gradient(#6c2632, #35151d); border: 1px solid #b88945; }
  .envelope-pocket { z-index: 3; clip-path: polygon(0 0, 50% 53%, 100% 0, 100% 100%, 0 100%); }
  .envelope-seams { position: absolute; inset: 0; z-index: 4; width: 100%; height: 100%; pointer-events: none; }
  .envelope-seams path { fill: none; stroke: #af854c; stroke-width: 1.5; }
  .envelope-flap {
    height: 55%; z-index: var(--flap-layer); transform-origin: 50% 0;
    transform: perspective(1100px) rotateX(var(--flap-angle));
    filter: drop-shadow(0 3px 2px rgb(72 32 14 / .28));
  }
  .envelope-flap > div { position: absolute; inset: 0; clip-path: polygon(0 0, 100% 0, 50% 100%); }
  .invitation-card {
    position: absolute; top: 5%; left: 5%; width: 90%; min-height: clamp(17rem, 43vw, 23rem);
    z-index: var(--card-layer); padding: 9% 10%; display: grid; justify-items: center; align-content: center; gap: .5rem;
    text-align: center; color: #4b1020;
    box-shadow: 0 12px 28px #21140f60, 0 0 40px rgb(255 207 121 / .25), inset 0 0 18px #e6c27b40;
    transform: translateY(var(--card-rise)) rotate(var(--card-turn)) scale(var(--card-scale)); opacity: var(--card-opacity);
    clip-path: inset(0 0 var(--card-mask) 0);
  }
  .invitation-card::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(115deg, transparent 35%, #fff8daaa 49%, transparent 63%);
    transform: translateX(var(--sheen-position)); opacity: var(--sheen-opacity);
  }
  /* Copy is printed on the card from the outset; scrolling never hides a name. */
  .invitation-card > * { position: relative; z-index: 2; }
  .invitation-card :global(.card-mark) { width: clamp(1.2rem, 4vw, 2rem); color: #9b6b2f; }
  .invitation-card h3 { display: grid; font-size: clamp(1.4rem, 4.3vw, 2.6rem); line-height: 1.05; }
  :lang(en) .invitation-card h3 > span { font: 400 1.25em/1.05 var(--font-script); }
  .invitation-card h3 em { font-size: .5em; color: #9b6b2f; }
  :lang(hi) .invitation-card h3 { font-size: clamp(1.2rem, 3.7vw, 2.15rem); line-height: 1.3; }
  .card-date { max-width: 90%; font-size: clamp(.8rem, 2vw, 1rem); line-height: 1.4; }
  .card-venue { max-width: 100%; font-size: .8rem; line-height: 1.3; color: #6b4a3d; }
  .card-link { display: inline-flex; gap: .4rem; align-items: center; justify-content: center; min-height: 44px; font-size: .85rem; line-height: 1.3; text-underline-offset: 4px; }
  .card-link :global(svg) { width: 1rem; flex-shrink: 0; }
  .seal-control {
    position: absolute; z-index: 7; top: var(--control-top); left: 50%; translate: -50% 0;
    min-width: 44px; min-height: 44px; padding: 0; display: grid; justify-items: center;
    border: 0; background: none; color: #fff1d8; cursor: pointer;
  }
  .wax-seal {
    position: relative; display: grid; place-items: center; width: clamp(3.4rem, 11vw, 5.4rem); aspect-ratio: 1;
    border-radius: 44% 49% 43% 47%; border: 3px solid #791b2b;
    background: radial-gradient(circle at 35% 25%, #ab3b47, #721223 65%, #420c19);
    box-shadow: inset 0 2px 4px #eb7e6260, inset 0 -3px 3px #300616, 0 4px 5px #36151380;
    opacity: var(--seal-opacity); transform: translateY(var(--seal-lift));
  }
  .wax-seal::before { content: ''; position: absolute; inset: 8%; border: 1px solid #d16559; border-radius: 50%; }
  .wax-seal :global(svg) { width: 42%; color: #e6c27b; }
  .seal-control:focus-visible { outline: 2px solid #fff1d8; outline-offset: 8px; border-radius: 50%; }
  @media (prefers-reduced-motion: no-preference) {
    [data-enhanced] .wax-seal::after {
      content: ''; position: absolute; inset: -8px; border-radius: 50%; pointer-events: none;
      background: radial-gradient(circle, #d9605577, #e6b96522 55%, transparent 72%);
      box-shadow: 0 0 22px #e7684470, 0 0 45px #e6b96530;
      animation: seal-beacon 2.8s ease-in-out infinite;
    }
    @keyframes seal-beacon { 0%, 100% { opacity: .3; scale: .9; } 50% { opacity: .95; scale: 1.14; } }
  }
  .envelope-footer { position: absolute; bottom: max(5.5rem, calc(env(safe-area-inset-bottom) + 5rem)); inset-inline: var(--gutter); display: flex; flex-wrap: wrap; justify-content: center; gap: .25rem 1.5rem; }
  .envelope-footer a { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; min-height: 44px; color: #fff1d8; font-size: .9rem; text-underline-offset: 5px; text-shadow: 0 2px 8px #21140f; }
  .envelope-footer :global(svg) { width: 1rem; }
  @media (max-width: 370px) { .invitation-card { min-height: 17.5rem; } .envelope-heading h2 { font-size: 1.6rem; } }
  @media (prefers-reduced-motion: reduce) {
    .envelope-flap { display: none; }
  }
</style>
