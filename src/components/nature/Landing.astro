---
/**
 * The bare domain (unified deploy): the welcome painting, the couple and the countdown, then a door
 * into each side's own invitation — the groom's (Amber Fort) and the bride's (Lake View), each in
 * its own site's painting and colour. A `?to=` personal link is carried through either door.
 */
import Base from '../../layouts/Base.astro';
import Art from './Art.astro';
import Countdown from './Countdown.astro';
import Icon from '../Icon.astro';
import LotusMark from '../LotusMark.astro';
import { type Lang, content, href, parseDate } from '../../lib/content';
import { coupleNames, themeConfig, themeCopy, themeHref } from '../../lib/theme';
import '../../styles/nature.css';
interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = {
  en: { kicker: 'You are cordially invited', lead: 'to celebrate the wedding of', choose: 'Open your invitation', open: 'Open invitation', sides: { 'amber-fort': "Groom's side", 'lake-city': "Bride's side" }, invitations: { 'amber-fort': "Ratnesh's invitation", 'lake-city': "Pallavi's invitation" } },
  hi: { kicker: 'आप सादर आमंत्रित हैं', lead: 'शुभ विवाह', choose: 'अपना निमंत्रण खोलें', open: 'निमंत्रण खोलें', sides: { 'amber-fort': 'वर पक्ष', 'lake-city': 'वधू पक्ष' }, invitations: { 'amber-fort': 'रत्नेश का निमंत्रण', 'lake-city': 'पल्लवी का निमंत्रण' } },
}[lang];
const [nameOne, nameTwo] = coupleNames(lang, 'nature');
const weddingDay = parseDate(content.site.weddingDate);
// Both sides' celebrations together: the groom's run 23–26, the bride's 23–25.
const dateLine = themeCopy('amber-fort', lang).dateLine;
const doors = (['amber-fort', 'lake-city'] as const).map(theme => ({
  theme,
  href: themeHref(lang, theme),
  side: copy.sides[theme],
  invitation: copy.invitations[theme],
  date: themeCopy(theme, lang).dateLine,
  painting: themeConfig[theme].assets.hero.mobile,
  tint: themeConfig[theme].themeColor,
}));
---
<Base lang={lang} theme="nature" page="landing">
  <main id="main" class="ns-landing" data-landing>
    <Art {...themeConfig.nature.assets.hero} eager class="ns-landing-art" />
    <div class="ns-landing-shade" aria-hidden="true"></div>
    <nav class="ns-landing-lang" aria-label="Language">
      <a href={href('en', '/')} lang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
      <a href={href('hi', '/')} lang="hi" aria-current={lang === 'hi' ? 'page' : undefined}>हिंदी</a>
    </nav>
    <header class="ns-landing-copy">
      <LotusMark class="ns-landing-lotus" />
      <p class="ns-landing-kicker">{copy.kicker}</p>
      <p class="ns-landing-lead">{copy.lead}</p>
      <h1 class="ns-landing-names"><span>{nameOne}</span> <em>{lang === 'hi' ? 'एवं' : '&'}</em> <span>{nameTwo}</span></h1>
      <p class="ns-landing-rule" aria-hidden="true"><i></i></p>
      <p class="ns-landing-date">{dateLine}</p>
      {weddingDay && <Countdown lang={lang} target={weddingDay} class="ns-landing-countdown" />}
    </header>
    <section class="ns-landing-doors" aria-labelledby="ns-landing-choose">
      <h2 id="ns-landing-choose" class="ns-landing-choose">{copy.choose}</h2>
      <ul>
        {doors.map(door => <li>
          <a class="ns-landing-door" href={door.href} style={`--tint: ${door.tint}`} data-landing-door>
            <Art mobile={door.painting} sizes="(min-width: 700px) 18rem, 90vw" class="ns-landing-door-art" />
            <span class="ns-landing-side">{door.side}</span>
            <span class="ns-landing-invitation">{door.invitation}</span>
            <span class="ns-landing-door-date">{door.date}</span>
            <span class="ns-landing-open">{copy.open}<Icon name="arrow-right" /></span>
          </a>
        </li>)}
      </ul>
    </section>
  </main>
</Base>
<script>
  import { setupCountdowns } from '../../scripts/countdown';
  const root = document.querySelector<HTMLElement>('[data-landing]');
  if (root) setupCountdowns(root, matchMedia('(prefers-reduced-motion: reduce)'));
  // A personal link (`?to=…`) keeps greeting the family on whichever invitation they open.
  if (location.search) document.querySelectorAll<HTMLAnchorElement>('[data-landing-door]').forEach(door => { door.search = location.search; });
</script>
<style>
  .ns-landing { position: relative; isolation: isolate; min-height: 100svh; display: grid; align-content: center; justify-items: center; gap: clamp(1.4rem, 4.5vh, 2.6rem); padding: clamp(4.5rem, 10vh, 6.5rem) 16px clamp(2rem, 6vh, 3.5rem); overflow: hidden; color: #fff4e0; text-align: center; background: #213b32; }
  .ns-landing :global(.ns-landing-art) { position: fixed; z-index: -2; }
  .ns-landing-shade { position: fixed; z-index: -1; inset: 0; pointer-events: none; background: radial-gradient(ellipse 70% 55% at 50% 38%, #10201a8c, #10201a33 70%), linear-gradient(#10201a99, #10201a26 35%, #10201acc); }
  .ns-landing-lang { position: absolute; top: 16px; right: 16px; display: flex; padding: 3px; border: 1px solid #e9c98766; border-radius: 30px; background: #10201a8c; }
  .ns-landing-lang a { display: grid; place-items: center; min-width: 44px; min-height: 40px; padding-inline: .8rem; border-radius: 30px; font: 500 .85rem/1 var(--font-ui); color: #f6e6c8; text-decoration: none; }
  .ns-landing-lang a[aria-current] { background: #fff4e0; color: #213b32; }

  .ns-landing-copy { display: grid; justify-items: center; gap: .45rem; text-shadow: 0 1px 3px #10201a, 0 2px 18px #10201acc; }
  .ns-landing-copy :global(.ns-landing-lotus) { width: 34px; color: #e9c987; }
  .ns-landing-kicker { font: 600 .74rem/1.3 var(--font-ui); letter-spacing: .3em; text-transform: uppercase; color: #e9c987; }
  .ns-landing-lead { font: italic 300 clamp(1.05rem, 2.2vw, 1.3rem)/1.3 var(--font-display); color: #f6e6c8; }
  .ns-landing-names { margin: .1rem 0; font: 400 clamp(3rem, 10vw, 5.6rem)/1.1 var(--font-script); color: #fff6e4; }
  .ns-landing-names em { font-style: normal; font-size: .62em; margin-inline: .08em; color: #e9c987; }
  :lang(hi) .ns-landing-names { font: 400 clamp(2.4rem, 7.5vw, 4.4rem)/1.35 var(--font-display); }
  :lang(hi) .ns-landing-kicker { font-size: 1rem; letter-spacing: .02em; }
  :lang(hi) .ns-landing-lead { font: 400 clamp(1.15rem, 2.4vw, 1.4rem)/1.35 var(--font-display); }
  .ns-landing-rule { display: flex; align-items: center; gap: 12px; color: #d6b06a; }
  .ns-landing-rule::before, .ns-landing-rule::after { content: ''; width: 72px; height: 1px; background: linear-gradient(90deg, #d6b06a00, #d6b06a); }
  .ns-landing-rule::after { scale: -1 1; }
  .ns-landing-rule i { width: 8px; height: 8px; rotate: 45deg; border: 1px solid currentColor; }
  .ns-landing-date { font: 400 clamp(1.15rem, 2.4vw, 1.45rem)/1.3 var(--font-display); color: #f3dcae; }
  .ns-landing :global(.ns-landing-countdown) { --count-w: clamp(3rem, 12vw, 4.2rem); --count-ink: #fff3de; --count-label: #ead7b4; --count-gold: #d6b06a; --count-spark: #f2c46d; --count-pane: #10201aa6; margin-top: .4rem; }

  .ns-landing-doors { display: grid; justify-items: center; gap: .9rem; width: 100%; }
  .ns-landing-choose { font: 600 .74rem/1.3 var(--font-ui); letter-spacing: .26em; text-transform: uppercase; color: #e9c987; text-shadow: 0 1px 6px #10201a; }
  :lang(hi) .ns-landing-choose { font-size: 1rem; letter-spacing: .02em; }
  .ns-landing-doors ul { display: grid; grid-template-columns: repeat(2, minmax(0, 18rem)); justify-content: center; gap: clamp(1rem, 3vw, 1.75rem); width: 100%; margin: 0; padding: 0; list-style: none; }
  /* Each door is an arched window onto that side's own welcome painting, in its colour. */
  .ns-landing-door { position: relative; isolation: isolate; display: grid; align-content: end; justify-items: center; gap: .3rem; min-height: clamp(15rem, 36vh, 20rem); padding: 1.4rem 1rem 1.25rem; overflow: hidden; border: 1.5px solid #d6b06a; border-radius: 999px 999px 18px 18px / 8.5rem 8.5rem 18px 18px; color: #fff4e0; text-decoration: none; box-shadow: 0 20px 50px #0008; transition: translate .5s cubic-bezier(.16,1,.3,1), box-shadow .5s cubic-bezier(.16,1,.3,1); }
  .ns-landing-door::before { content: ''; position: absolute; z-index: -1; inset: 0; background: linear-gradient(color-mix(in srgb, var(--tint) 0%, transparent) 15%, color-mix(in srgb, var(--tint) 72%, transparent) 52%, var(--tint) 88%); }
  .ns-landing-door::after { content: ''; position: absolute; inset: 7px; border: 1px solid #e9c98766; border-radius: 999px 999px 12px 12px / 8rem 8rem 12px 12px; pointer-events: none; }
  .ns-landing-door :global(.ns-landing-door-art) { z-index: -2; }
  .ns-landing-door :global(.ns-landing-door-art img) { transition: scale 1.2s cubic-bezier(.16,1,.3,1); }
  .ns-landing-door:hover, .ns-landing-door:focus-visible { translate: 0 -4px; box-shadow: 0 28px 60px #000a; }
  .ns-landing-door:hover :global(.ns-landing-door-art img), .ns-landing-door:focus-visible :global(.ns-landing-door-art img) { scale: 1.05; }
  .ns-landing-door:focus-visible { outline: 2px solid #fff0c9; outline-offset: 4px; }
  .ns-landing-side { font: 600 .68rem/1.3 var(--font-ui); letter-spacing: .26em; text-transform: uppercase; color: #e9c987; }
  :lang(hi) .ns-landing-side { font-size: .95rem; letter-spacing: .02em; }
  .ns-landing-invitation { font: 400 clamp(1.4rem, 2.6vw, 1.7rem)/1.2 var(--font-display); }
  .ns-landing-door-date { font: 400 .92rem/1.3 var(--font-display); color: #f3dcae; }
  .ns-landing-open { display: inline-flex; align-items: center; gap: .45rem; min-height: 44px; margin-top: .45rem; padding: .4rem 1.1rem; border: 1px solid #e9c98799; border-radius: 30px; font: 500 .82rem/1 var(--font-ui); letter-spacing: .04em; background: #fff4e014; }
  .ns-landing-open :global(svg) { width: 15px; height: 15px; }
  /* Phones: both doors side by side, so the choice is seen whole without scrolling. */
  @media (max-width: 559px) {
    .ns-landing-doors ul { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
    .ns-landing-door { min-height: clamp(12.5rem, 33svh, 15rem); gap: .2rem; padding: .9rem .5rem 1rem; border-radius: 999px 999px 14px 14px / 5rem 5rem 14px 14px; }
    .ns-landing-door::before { background: linear-gradient(color-mix(in srgb, var(--tint) 0%, transparent) 5%, color-mix(in srgb, var(--tint) 78%, transparent) 42%, var(--tint) 78%); }
    .ns-landing-door::after { inset: 5px; border-radius: 999px 999px 10px 10px / 4.6rem 4.6rem 10px 10px; }
    .ns-landing-side { font-size: .58rem; letter-spacing: .18em; }
    :lang(hi) .ns-landing-side { font-size: .85rem; }
    .ns-landing-invitation { font-size: 1.12rem; }
    .ns-landing-door-date { font-size: .76rem; }
    .ns-landing-open { margin-top: .3rem; padding-inline: .8rem; font-size: .74rem; gap: .3rem; }
  }
  @media (max-width: 339px) { .ns-landing-doors ul { grid-template-columns: minmax(0, 1fr); } }

  /* The page arrives once: the copy, then each door, rising in. */
  @media (prefers-reduced-motion: no-preference) {
    .ns-landing-copy > *, .ns-landing-choose, .ns-landing-doors li { animation: ns-landing-rise 1s cubic-bezier(.16,1,.3,1) backwards; }
    .ns-landing-copy > :nth-child(2) { animation-delay: .1s; } .ns-landing-copy > :nth-child(3) { animation-delay: .18s; }
    .ns-landing-copy > :nth-child(4) { animation-delay: .26s; } .ns-landing-copy > :nth-child(5) { animation-delay: .36s; }
    .ns-landing-copy > :nth-child(6) { animation-delay: .42s; } .ns-landing-copy > :nth-child(7) { animation-delay: .5s; }
    .ns-landing-choose { animation-delay: .62s; }
    .ns-landing-doors li:nth-child(1) { animation-delay: .72s; } .ns-landing-doors li:nth-child(2) { animation-delay: .84s; }
  }
  @keyframes ns-landing-rise { from { opacity: 0; translate: 0 1.2rem; } }
</style>
