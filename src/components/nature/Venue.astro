---
import Art from './Art.astro';
import ScenePlate from './ScenePlate.astro';
import Icon from '../Icon.astro';
import LotusMark from '../LotusMark.astro';
import { type Lang, content, loc, t } from '../../lib/content';
import { themeConfig, themeCopy, type ThemeId } from '../../lib/theme';
interface Props { lang: Lang; theme?: ThemeId }
const { lang, theme = 'nature' } = Astro.props;
const c = themeCopy(theme, lang);
const landscapes = themeConfig[theme].assets;
const locations = content.venue.locations ?? [];
const directionsFor = (location: (typeof locations)[number]) =>
  `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${loc(location.name, 'en')}, ${loc(location.address, 'en')}`)}`;
---
<section id="venue" class="ns-venue ns-scene" aria-labelledby="ns-venue-title">
  <ScenePlate><Art {...landscapes.venue} /><div class="ns-venue-shade"></div></ScenePlate>
  <header class="ns-venue-head" data-venue-reveal>
    <span class="ns-venue-index" aria-hidden="true">04</span>
    <div><p class="ns-kicker">{c.venueKicker}</p><h2 id="ns-venue-title">{c.venueExperience}</h2><p class="ns-venue-intro">{c.venueLine}</p></div>
  </header>
  <div class="ns-venue-stage">
    <div class="ns-venue-locations" data-venue-reveal>
      {locations.map(location => <article class="ns-location-card">
        <LotusMark class="ns-lotus" />
        <p class="ns-kicker">{loc(location.label, lang)}</p>
        <h3>{loc(location.name, lang)}</h3>
        <address>{loc(location.address, lang)}</address>
        <p class="ns-location-note">{loc(location.note, lang)}</p>
        <div class="ns-location-actions">
          <a class="ns-wood-sign ns-wood-sign-compact" href={location.mapUrl} target="_blank" rel="noopener">
            <span class="ns-sign-icon"><Icon name="pin" /></span><span>{t(lang, 'viewMap')}</span>
          </a>
          <a class="ns-wood-sign ns-wood-sign-compact" href={directionsFor(location)} target="_blank" rel="noopener">
            <span class="ns-sign-icon"><Icon name="arrow-right" /></span><span>{loc(content.venue.directionsLabel, lang)}</span>
          </a>
        </div>
      </article>)}
    </div>
  </div>
</section>
