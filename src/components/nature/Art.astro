---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
interface Props { mobile: ImageMetadata; desktop?: ImageMetadata; eager?: boolean; class?: string }
const { mobile, desktop, eager = false, class: cls = '' } = Astro.props;
const variants = async (src: ImageMetadata, widths: number[], format: 'avif' | 'webp') =>
  (await Promise.all(widths.map(async width => {
    const img = await getImage({ src, width, format, quality: format === 'avif' ? 53 : 76 });
    return `${img.src} ${width}w`;
  }))).join(', ');
const sources = await Promise.all((['avif', 'webp'] as const).map(async format => ({
  type: `image/${format}`, mobile: await variants(mobile, [480, 768, 1024], format),
  desktop: desktop ? await variants(desktop, [1280, 1672], format) : undefined,
})));
const fallback = await getImage({ src: mobile, width: 768, format: 'webp', quality: 76 });
const staticWide = desktop ? await getImage({ src: desktop, width: 1280, format: 'webp', quality: 76 }) : fallback;
---
<div class:list={['ns-art', cls]} aria-hidden="true" data-nature-art>
  <svg class="ns-fallback" viewBox="0 0 1000 800" preserveAspectRatio="xMidYMid slice" focusable="false">
    <path d="M0 480L120 320 250 470 450 240 650 460 800 350 1000 470V800H0Z" fill="#776a78" opacity=".4" />
    <path d="M0 580Q230 400 480 560T1000 500V800H0Z" fill="#425d43" />
    <path d="M0 680Q260 540 490 650T1000 620V800H0Z" fill="#213b32" />
    <path d="M400 800Q650 650 600 560Q580 500 700 490" fill="none" stroke="#f4c395" stroke-width="32" opacity=".55" />
  </svg>
  <picture>
    {sources.map(source => <>
      {source.desktop && <source media="(min-width: 768px) and (min-aspect-ratio: 1/1)" type={source.type} srcset={source.desktop} sizes="100vw" />}
      <source type={source.type} srcset={source.mobile} sizes={desktop ? '100vw' : '(min-width: 1000px) 360px, 90vw'} />
    </>)}
    <img src={fallback.src} width={mobile.width} height={mobile.height} alt="" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" data-nature-image />
  </picture>
  <noscript><div class="ns-static" style={`--mobile: url('${fallback.src}'); --wide: url('${staticWide.src}')`}></div></noscript>
</div>
<script>
  document.querySelectorAll<HTMLImageElement>('[data-nature-image]').forEach(img => {
    const update = () => img.closest('picture')?.toggleAttribute('data-failed', img.complete && !img.naturalWidth);
    img.addEventListener('error', () => img.closest('picture')?.setAttribute('data-failed', ''));
    img.addEventListener('load', update);
    if (img.complete) update();
  });
</script>
<style>
  .ns-art { position: absolute; inset: 0; overflow: hidden; background: linear-gradient(#6a586a, #f2a27d 45%, #213b32); }
  .ns-art picture, .ns-art img, .ns-fallback, .ns-static, .ns-art > noscript { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ns-art img { object-fit: cover; }
  picture[data-failed] { display: none; }
  .ns-static { background: var(--mobile) center / cover no-repeat; }
  @media (min-width: 768px) and (min-aspect-ratio: 1/1) { .ns-static { background-image: var(--wide); } }
  @media (scripting: none) { picture { display: none; } }
</style>
