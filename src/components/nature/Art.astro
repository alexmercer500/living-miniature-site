---
import type { ImageMetadata } from 'astro';
import { artSources } from '../../lib/art-sources';
import { artPreview } from '../../lib/art-preview';
/** `preview={false}` for art that only appears once decoded (the camera bridges), to keep the HTML light. */
interface Props { mobile: ImageMetadata; desktop?: ImageMetadata; eager?: boolean; class?: string; sizes?: string; preview?: boolean }
const { mobile, desktop, eager = false, class: cls = '', sizes, preview = true } = Astro.props;
const { sources, fallback, staticWide } = await artSources(mobile, desktop);
const [previewMobile, previewWide] = preview ? await Promise.all([artPreview(mobile), desktop && artPreview(desktop)]) : [];
const previewStyle = [previewMobile && `--preview: ${previewMobile}`, previewWide && `--preview-wide: ${previewWide}`].filter(Boolean).join('; ') || undefined;
---
<div class:list={['ns-art', cls]} aria-hidden="true" data-nature-art style={previewStyle}>
  <picture>
    {sources.map(source => <>
      {source.desktop && <source media="(min-width: 768px) and (min-aspect-ratio: 1/1)" type={source.type} srcset={source.desktop} sizes={sizes ?? '100vw'} />}
      <source type={source.type} srcset={source.mobile} sizes={sizes ?? (desktop ? '100vw' : '(min-width: 1000px) 360px, 90vw')} />
    </>)}
    <img src={fallback.src} width={mobile.width} height={mobile.height} alt="" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" data-nature-image />
  </picture>
  <noscript><div class="ns-static" style={`--mobile: url('${fallback.src}'); --wide: url('${staticWide.src}')`}></div></noscript>
</div>
<script>
  document.querySelectorAll<HTMLImageElement>('[data-nature-image]').forEach(img => {
    const update = () => img.closest('picture')?.toggleAttribute('data-failed', img.complete && !img.naturalWidth);
    img.addEventListener('error', () => img.closest('picture')?.setAttribute('data-failed', ''));
    img.addEventListener('load', update);
    if (img.complete) update();
  });
</script>
<style>
  /* Until (or unless) the painting arrives, its own blurred preview shows; the gradient is the last resort. */
  .ns-art { position: absolute; inset: 0; overflow: hidden; background: var(--preview, none) center / cover no-repeat, linear-gradient(#6a586a, #f2a27d 45%, #213b32); }
  @media (min-width: 768px) and (min-aspect-ratio: 1/1) { .ns-art { background-image: var(--preview-wide, var(--preview, none)), linear-gradient(#6a586a, #f2a27d 45%, #213b32); } }
  .ns-art picture, .ns-art img, .ns-static, .ns-art > noscript { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ns-art img { object-fit: cover; }
  picture[data-failed] { display: none; }
  .ns-static { background: var(--mobile) center / cover no-repeat; }
  @media (min-width: 768px) and (min-aspect-ratio: 1/1) { .ns-static { background-image: var(--wide); } }
  @media (scripting: none) { picture { display: none; } }
</style>
