---
import Base from '../../layouts/Base.astro';
import Header from './Header.astro';
import Art from './Art.astro';
import HeroLantern from './HeroLantern.astro';
import HeroAtmosphere from './HeroAtmosphere.astro';
import OpeningVeil from './OpeningVeil.astro';
import HeroJourneyBridge from './HeroJourneyBridge.astro';
import SceneBridges from './SceneBridges.astro';
import Keepsakes from './Keepsakes.astro';
import Celebrations from './Celebrations.astro';
import Venue from './Venue.astro';
import Wishes from './Wishes.astro';
import FinalNote from './FinalNote.astro';
import Envelope from './Envelope.astro';
import Icon from '../Icon.astro';
import LotusMark from '../LotusMark.astro';
import { type Lang, content, loc, t, formatDate } from '../../lib/content';
import { natureHref, natureCopy } from '../../lib/nature-content';
import { landscapes } from '../../lib/nature-assets';
import { artPreview } from '../../lib/art-preview';
import { artSources } from '../../lib/art-sources';
import '../../styles/nature.css';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = natureCopy[lang];
const [veilScene, veilSceneWide] = await Promise.all([artPreview(landscapes.hero.mobile), artPreview(landscapes.hero.desktop)]);
// Ask for every chapter painting with the HTML, before anything has to be laid out: the scene you
// scroll into then never shows its soft inline placeholder, and each camera handoff has its art
// decoded by the time it is needed. AVIF only — a browser without AVIF skips the hint and loads
// the WebP the <picture> asks for, and the URL matches the srcset exactly, so nothing loads twice.
const paintingPreloads = (await Promise.all(Object.values(landscapes).map(async painting => {
  const { sources } = await artSources(painting.mobile, painting.desktop);
  return sources.find(source => source.type === 'image/avif')!;
}))).filter(p => p.desktop);
---
<Base lang={lang} routePath="/" title={`${loc(content.couple.displayName, lang)} — ${t(lang, 'weddingInvitation')}`}>
  <Fragment slot="head">
    {paintingPreloads.map(p => (
      <Fragment>
        {p.desktop && <link rel="preload" as="image" type="image/avif" media="(min-width: 768px) and (min-aspect-ratio: 1/1)" imagesrcset={p.desktop} imagesizes="100vw" />}
        <link rel="preload" as="image" type="image/avif" media="(max-width: 767px), (max-aspect-ratio: 1/1)" imagesrcset={p.mobile} imagesizes="100vw" />
      </Fragment>
    ))}
  </Fragment>
  <script is:inline>
    // Personal links (`?to=Sharma Parivar`) greet the family by name. The name lives only in
    // the link and on this device; it is written as text, never as HTML.
    (() => {
      let name = '';
      try {
        name = [...(new URLSearchParams(location.search).get('to') || '')].filter(ch => ch >= ' ' && !'<>{}'.includes(ch)).join('').replace(/ +/g, ' ').trim().slice(0, 48);
        if (name) localStorage.setItem('ns-guest', name); else name = localStorage.getItem('ns-guest') || '';
      } catch { /* storage blocked: greet only from the link */ }
      window.nsGuest = name;
      window.nsGreet = el => { if (name && el) { el.textContent = el.dataset.template.replace('{name}', name); el.hidden = false; } };
    })();
  </script>
  <OpeningVeil scene={veilScene} sceneWide={veilSceneWide} greeting={t(lang, 'guestGreeting')} />
  <Header lang={lang} />
  <main id="main" class="ns-home" data-nature-root>
    <HeroJourneyBridge />
    <SceneBridges />
    <section id="welcome" class="ns-hero ns-scene" aria-labelledby="nature-title">
      <Art {...landscapes.hero} eager />
      <div class="ns-hero-shade"></div>
      <div class="ns-hero-copy">
        <LotusMark class="ns-lotus" />
        <p class="ns-greeting" data-template={t(lang, 'guestGreeting')} hidden></p><script is:inline>nsGreet(document.currentScript.previousElementSibling)</script>
        <p class="ns-kicker">{c.chapter}</p>
        <h1 id="nature-title"><span>{c.heroOne}</span><em>{c.heroTwo}</em></h1>
        <p class="ns-couple">{loc(content.couple.displayName, lang)}</p>
        <div class="ornament"><span></span></div>
        <p class="ns-date">{loc(content.site.weddingDateLabel, lang)}</p>
      </div>
      <button class="ns-lantern-touch" type="button" data-nature-lantern aria-label={c.light} aria-pressed="false" disabled><span class="ns-lantern-swing"><HeroLantern /></span></button>
      <button class="ns-petal-touch" type="button" data-nature-petals aria-label={c.petals} disabled><span aria-hidden="true">✿</span></button>
      <div class="ns-hero-foot">
        <a href="#journey" class="ns-scroll"><span><Icon name="arrow-down" /></span>{t(lang, 'scrollToBegin')}</a>
        <a href="#celebrations" class="ns-skip">{t(lang, 'jumpToDetails')} ↗</a>
      </div>
      <HeroAtmosphere />
    </section>

    <section id="journey" class="ns-story ns-scene" aria-labelledby="ns-story-title">
      <div class="ns-story-landscape ns-scene">
        <Art {...landscapes.journey} />
        <div class="ns-story-shade"></div>
        <header class="ns-story-copy"><p class="ns-kicker">01 / {c.story}</p><h2 id="ns-story-title">{c.storyTitle}</h2><p>{c.storyIntro}</p></header>
        <svg class="ns-path" viewBox="0 0 1000 700" preserveAspectRatio="none" aria-hidden="true"><path d="M80 680C100 500 620 640 500 430S600 240 730 190" pathLength="1" /></svg>
      </div>
      <Keepsakes lang={lang} />
      <p class="ns-keepsake-hint">{c.keepsakeHint}</p>
    </section>

    <Envelope lang={lang} invitationHref={natureHref(lang, '/invitation')}>
      <Art slot="backdrop" {...landscapes.letter} />
    </Envelope>

    <Celebrations lang={lang} />

    <Venue lang={lang} />

    <Wishes lang={lang} />

    <FinalNote lang={lang} />
  </main>
  <footer class="ns-footer"><p>{loc(content.couple.displayName, lang)}</p><p>{formatDate(content.site.weddingDate, lang, true) ?? loc(content.site.weddingDateLabel, lang)}</p></footer>
  <nav class="ns-dock" aria-label={t(lang, 'jumpToDetails')}><a href="#journey">{c.story}</a><a href="#venue"><Icon name="pin" />{t(lang, 'venue')}</a><a href={natureHref(lang, '/invitation')}><Icon name="calendar" />{t(lang, 'invitation')}</a></nav>
  <div class="ns-progress" aria-hidden="true"><span data-nature-progress></span></div>
</Base>
<script>
  import { setupNature } from '../../scripts/nature';
  import { setupEnvelope } from '../../scripts/envelope';
  const initialHash = location.hash;
  let interrupted = false;
  // Ask for the chapter paintings as soon as this module runs — the DOM is parsed by then, and
  // this is well before the camera scripts finish loading GSAP or the fonts settle. They are
  // requested at low priority, so the hero (eager, high) and the art of the chapter you are
  // heading into (requested eagerly by the camera bridges) still win a slow connection.
  for (const image of document.querySelectorAll<HTMLImageElement>('[data-nature-image][loading="lazy"]')) { image.loading = 'eager'; image.fetchPriority = 'low'; }
  const interrupt = () => { interrupted = true; };
  const inputEvents = ['wheel', 'touchstart', 'pointerdown', 'keydown'] as const;
  inputEvents.forEach(event => window.addEventListener(event, interrupt, { passive: true }));
  Promise.allSettled([
    setupNature().catch(error => console.warn('Nature animation unavailable; static content remains readable.', error)),
    setupEnvelope().catch(error => console.warn('Envelope animation unavailable; static invitation remains readable.', error)),
  ]).then(async () => {
    await document.fonts.ready;
    await new Promise<void>(resolve => requestAnimationFrame(() => requestAnimationFrame(() => resolve())));
    // ScrollTrigger/font initialization can restore the pre-hash scroll position.
    // Resolve the original deep link once, before the cameras start following scroll.
    // Never override a guest who has already started scrolling or navigating.
    if (!interrupted && initialHash && location.hash === initialHash) {
      let target: HTMLElement | null = null;
      try { target = document.getElementById(decodeURIComponent(initialHash.slice(1))); } catch { /* malformed hash: leave native navigation alone */ }
      if (target?.closest('[data-nature-root]')) window.scrollTo({ top: scrollY + target.getBoundingClientRect().top, behavior: 'instant' });
    }
    document.documentElement.dataset.natureReady = '';
    // The footer rides over the closing painting by its own height, so measure it once the
    // fonts are in (and again on resize) and hand the value to the stylesheet.
    const footer = document.querySelector<HTMLElement>('.ns-footer');
    if (footer) {
      const lift = () => document.documentElement.style.setProperty('--ns-footer-lift', `${footer.offsetHeight}px`);
      lift();
      window.addEventListener('resize', lift);
    }
    inputEvents.forEach(event => window.removeEventListener(event, interrupt));
  });
</script>
