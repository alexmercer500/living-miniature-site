---
// Decorative extras shared by every camera handoff (see camera-flourish-state.ts).
// The rim traces the leafy reveal edge: a gold line and a soft candle halo.
// Petals and candle sparks cross that edge as it rises; a warm light sweeps the settling scene.
import { PETAL_COUNT } from '../../lib/camera-flourish-state';
---
<div class="ns-flourish-sweep"></div>
<div class="ns-flourish-rim"><i class="halo"></i><i class="line"></i></div>
{Array.from({length:PETAL_COUNT},(_,i)=><i class:list={['ns-flourish-petal',i%4===3?'spark':'petal']} style={`--size:${[14,11,16,12,15,13,10,17,12,14,11,15][i]}px`} />)}
