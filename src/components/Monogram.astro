---
import { coupleInitials, type ThemeId } from '../lib/theme';
interface Props { class?: string; theme?: ThemeId }
const [a, b] = coupleInitials(Astro.props.theme ?? 'nature');
---
<span class:list={['monogram', Astro.props.class]} aria-hidden="true"><span>{a}</span><i></i><span>{b}</span></span>

<style>
  .monogram {
    display: inline-flex;
    align-items: center;
    gap: 0.28em;
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1;
    color: var(--color-gold-highlight);
  }
  .monogram i {
    width: 1px;
    height: 1.15em;
    background: linear-gradient(transparent, currentColor 25%, currentColor 75%, transparent);
  }
</style>
