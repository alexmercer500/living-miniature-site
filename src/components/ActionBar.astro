---
import { type Lang, t, href, content, loc, mapConfigured, rsvpConfigured } from '../lib/content';
import Icon from './Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const home = href(lang, '/');
---
<noscript><style is:inline>.action-bar[data-hidden] { translate: -50% 0 !important; opacity: 1 !important; pointer-events: auto !important; }</style></noscript>
<nav class="action-bar" aria-label={t(lang, 'jumpToDetails')} data-action-bar data-hidden>
  <a href={`${home}#venue`}><Icon name="pin" /><span>{t(lang, 'venue')}</span></a>
  <a href={href(lang, '/invitation')}><Icon name="calendar" /><span>{t(lang, 'invitation')}</span></a>
  {rsvpConfigured() && (
    <a class="rsvp" href={content.rsvp.url} target="_blank" rel="noopener"><Icon name="heart" /><span>{loc(content.rsvp.label, lang)}</span></a>
  )}
</nav>

<script>
  // Reveal after the hero and step aside at the closing scene; without JS the bar is always visible.
  const bar = document.querySelector<HTMLElement>('[data-action-bar]');
  const sentinel = document.querySelector('[data-hero-end]');
  const closing = document.getElementById('closing');
  if (bar && sentinel) {
    let pastHero = false;
    let atClosing = false;
    const sync = () => bar.toggleAttribute('data-hidden', !pastHero || atClosing);
    sync();
    new IntersectionObserver(([e]) => { pastHero = !e.isIntersecting && e.boundingClientRect.top < 0; sync(); }).observe(sentinel);
    if (closing) new IntersectionObserver(([e]) => { atClosing = e.isIntersecting; sync(); }, { threshold: 0.35 }).observe(closing);
  }
</script>

<style>
  .action-bar {
    position: fixed;
    z-index: 40;
    left: 50%;
    bottom: max(var(--space-3), env(safe-area-inset-bottom));
    translate: -50% 0;
    display: flex;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--color-line-gold);
    border-radius: var(--radius-pill);
    background: rgb(23 23 44 / 0.86);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.35);
    transition: translate var(--dur-base) var(--ease-out), opacity var(--dur-base);
  }
  .action-bar[data-hidden] { translate: -50% 160%; opacity: 0; pointer-events: none; }
  .action-bar a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    padding: 0 var(--space-4);
    border-radius: var(--radius-pill);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    white-space: nowrap;
    color: var(--color-text-light);
  }
  .action-bar a:hover { background: rgb(242 213 154 / 0.12); }
  .action-bar a.rsvp { background: var(--color-vermilion); }
  .action-bar :global(svg) { width: 1.1rem; height: 1.1rem; color: var(--color-gold-highlight); }
  @media (max-width: 359px) { .action-bar a { padding: 0 var(--space-3); } }
</style>
