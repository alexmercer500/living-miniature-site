---
// A small cluster of lotus pads with one or two blooms, in a 200×70 box.
interface Props { class?: string; style?: string; blooms?: number }
const { class: cls = '', style, blooms = 2 } = Astro.props;
const petals = [-50, -25, 0, 25, 50];
---
<svg class:list={['lotus', cls]} style={style} viewBox="0 0 200 70" aria-hidden="true" focusable="false">
  <ellipse cx="60" cy="56" rx="46" ry="9" fill="#243A30" />
  <path d="M60,56 L104,52 A46,9 0 0 0 96,50 Z" fill="#17172C" opacity=".5" />
  <ellipse cx="140" cy="60" rx="38" ry="7" fill="#2E4A3A" />
  <ellipse cx="112" cy="47" rx="26" ry="5" fill="#314B3E" />
  {[{ x: 70, y: 50, s: 1 }, { x: 140, y: 56, s: 0.75 }].slice(0, blooms).map(({ x, y, s }) => (
    <g transform={`translate(${x} ${y}) scale(${s})`}>
      {petals.map((a) => (
        <path d="M0,0 C-7,-8 -6,-22 0,-30 C6,-22 7,-8 0,0Z" fill="url(#lm-lotus)" transform={`rotate(${a})`} opacity={Math.abs(a) === 50 ? 0.85 : 1} />
      ))}
      <ellipse cx="0" cy="-2" rx="6" ry="2.4" fill="#F2D59A" />
    </g>
  ))}
</svg>
