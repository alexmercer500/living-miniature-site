---
/**
 * Small miniature scenes seen through each event's jharokha window (300×360 box).
 * Keyed by `visualKey` from the content model; unknown keys fall back to the courtyard.
 */
interface Props { visualKey: string }
const { visualKey } = Astro.props;
const VISUAL_KEYS = ['floral-courtyard', 'varmala', 'lantern-garden', 'mandap-courtyard', 'haldi', 'mehndi', 'sangeet', 'baraat', 'reception'];
const key = VISUAL_KEYS.includes(visualKey) ? visualKey : 'floral-courtyard';
const MARIGOLD = ['#F29A2E', '#F7B538', '#E9822A'];
const strand = (x: number, n: number) => Array.from({ length: n }, (_, i) => ({ x, y: 8 + i * 9, c: MARIGOLD[(i + x) % 3] }));
const torans = [30, 60, 90, 120, 150, 180, 210, 240, 270].flatMap((x, i) => strand(x, i % 2 ? 6 : 10));
const lanterns = [[50, 70], [96, 120], [150, 60], [204, 110], [250, 80]];
const mangoLeaves = Array.from({ length: 16 }, (_, i) => ({ x: 9 + i * 18.5, r: 80 + (i % 2) * 20 }));
const mandala = [14, 28, 44].flatMap((rad, ring) => Array.from({ length: 8 + ring * 4 }, (_, i) => ({ a: (360 / (8 + ring * 4)) * i, rad, ring })));
const bulbs = Array.from({ length: 15 }, (_, i) => { const t = i / 14; return { x: 8 + t * 284, y: 26 + Math.sin(Math.PI * t) * 28, c: ['#FFD98A', '#E8648C', '#7FD1C7', '#F7B538'][i % 4] }; });
const bursts = [[78, 70, 30, '#F7B538'], [222, 52, 26, '#E8648C'], [160, 118, 20, '#FFE7AE']] as const;
const rays = (cx: number, cy: number, rad: number) => Array.from({ length: 14 }, (_, i) => { const a = (Math.PI * 2 * i) / 14; return { x1: cx + Math.cos(a) * rad * 0.35, y1: cy + Math.sin(a) * rad * 0.35, x2: cx + Math.cos(a) * rad, y2: cy + Math.sin(a) * rad }; });
const walkers = [[40, 292, 0.8], [88, 286, 0.9], [138, 290, 1], [186, 284, 0.92], [234, 290, 0.85], [272, 296, 0.75]] as const;
const archBlooms = Array.from({ length: 22 }, (_, i) => { const a = Math.PI * (1 - i / 21); return { x: (150 + Math.cos(a) * 92).toFixed(1), y: (168 - Math.sin(a) * 104).toFixed(1), c: ['#D9406F', '#F7B538', '#E8648C', '#FFF3E2'][i % 4] }; });
const drops = Array.from({ length: 11 }, (_, i) => ({ x: 122 + i * 5.6, y2: 62 + (i % 3) * 5 }));
const smallDiya = '<circle cx="30" cy="22" r="26" fill="url(#lm-halo)" /><path d="M30,6 C36,16 37,24 30,30 C23,24 24,16 30,6Z" fill="url(#lm-flame)" /><path d="M5,31 C10,46 50,46 55,31 C46,35 14,35 5,31Z" fill="url(#lm-brass)" />';
const lights = Array.from({ length: 26 }, (_, i) => {
  const t = i / 25;
  return { x: 10 + t * 280, y: 40 + Math.sin(Math.PI * t) * 36 };
});
---
<svg class="vignette" viewBox="0 0 300 360" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  {(key === 'floral-courtyard' || key === 'varmala') && (
    <>
      <rect width="300" height="360" fill="url(#vg-dusk)" />
      <circle cx="150" cy="200" r="70" fill="url(#lm-halo)" opacity=".6" />
      <rect x="94" y="116" width="112" height="112" fill="#5B201E" stroke="#E6C27B" stroke-width="2" />
      <rect x="110" y="132" width="80" height="96" fill="#B87950" opacity=".65" />
      <path d="M104,126 H196 M104,138 H196 M104,150 H196" stroke="#E6C27B" stroke-opacity=".6" stroke-width="2" />
      <path d="M116,118 Q150,96 184,118" fill="none" stroke="#40533A" stroke-width="4" />
      {[122, 138, 154, 170].map((x) => <circle cx={x} cy="108" r="5" fill="#F29A2E" />)}
      <rect x="0" y="230" width="300" height="130" fill="#C98C86" />
      <rect x="0" y="230" width="300" height="6" fill="#8F5A6C" />
      <rect x="18" y="70" width="26" height="160" fill="url(#lm-sandstone)" /><rect x="256" y="70" width="26" height="160" fill="url(#lm-sandstone)" />
      <rect x="12" y="60" width="38" height="12" fill="#8F5A6C" /><rect x="250" y="60" width="38" height="12" fill="#8F5A6C" />
      <ellipse cx="150" cy="300" rx="90" ry="26" fill="none" stroke="#FFF3E2" stroke-width="2" opacity=".75" />
      <ellipse cx="150" cy="300" rx="62" ry="17" fill="none" stroke="#F7B538" stroke-width="5" stroke-dasharray="2 7" stroke-linecap="round" />
      <ellipse cx="150" cy="300" rx="34" ry="9" fill="#B8285A" opacity=".85" />
      {[70, 110, 190, 230].map((x) => (
        <g transform={`translate(${x - 12} 318) scale(.4)`}><circle cx="30" cy="22" r="26" fill="url(#lm-halo)" /><path d="M30,6 C36,16 37,24 30,30 C23,24 24,16 30,6Z" fill="url(#lm-flame)" /><path d="M5,31 C10,46 50,46 55,31 C46,35 14,35 5,31Z" fill="url(#lm-brass)" /></g>
      ))}
      {torans.map((b) => <circle cx={b.x} cy={b.y} r="4.6" fill={b.c} />)}
      {key === 'varmala' && (
        <>
          <circle cx="132" cy="214" r="10" fill="#2B1717" /><path d="M119,228 Q132,212 145,228 L145,252 H119Z" fill="#B83A32" />
          <circle cx="168" cy="214" r="10" fill="#2B1717" /><path d="M155,228 Q168,212 181,228 L181,252 H155Z" fill="#40533A" />
          <path d="M128,230 Q150,250 172,230" fill="none" stroke="#F7B538" stroke-width="5" stroke-dasharray="2 5" />
        </>
      )}
    </>
  )}
  {key === 'lantern-garden' && (
    <>
      <rect width="300" height="360" fill="url(#vg-night)" />
      <circle cx="80" cy="250" r="70" fill="#22352C" /><circle cx="210" cy="240" r="84" fill="#2A4134" /><circle cx="150" cy="280" r="60" fill="#314B3E" />
      <path d="M0,300 Q150,280 300,300 V360 H0Z" fill="#24382D" />
      {lights.map((p) => <circle cx={p.x} cy={p.y} r="2.2" fill="#FFE7AE" filter="url(#lm-glow-small)" />)}
      {lanterns.map(([x, len]) => (
        <g transform={`translate(${x - 15} 0)`}>
          <line x1="15" y1="0" x2="15" y2={len} stroke="#C49A55" stroke-width="1" />
          <circle cx="15" cy={len + 18} r="24" fill="url(#lm-halo)" />
          <path d={`M9,${len} H21 L25,${len + 6} H5 Z`} fill="url(#lm-brass)" />
          <rect x="6" y={len + 6} width="18" height="26" rx="4" fill="url(#lm-glass)" />
          <path d={`M6,${len + 32} H24 L20,${len + 37} H10 Z`} fill="url(#lm-brass)" />
        </g>
      ))}
      {[[40, 330], [120, 318], [196, 334], [262, 322]].map(([x, y]) => <path d={`M${x},${y} c-4,-8 -2,-16 3,-20 c5,4 7,12 3,20z`} fill="#3D5F49" />)}
    </>
  )}
  {key === 'mandap-courtyard' && (
    <>
      <rect width="300" height="360" fill="url(#vg-rose)" />
      <rect x="0" y="262" width="300" height="98" fill="#8F5A6C" />
      <rect x="0" y="262" width="300" height="4" fill="#C49A55" opacity=".7" />
      <rect x="62" y="248" width="176" height="18" fill="#F3CBAE" />
      <rect x="58" y="104" width="184" height="18" fill="url(#lm-wood)" stroke="#E6C27B" stroke-width="2" />
      <path d="M70,104 H230 L214,84 H86Z" fill="#7A1F2B" />
      <path d="M78,102 Q150,132 222,102" fill="none" stroke="#E6C27B" stroke-width="2" />
      {[70, 116, 176, 222].map((x) => <rect x={x} y="114" width="8" height="134" fill="#F2D59A" />)}
      <path d="M78,114 Q96,170 78,248 L70,248 L70,114Z" fill="#9C3540" opacity=".9" />
      <path d="M222,114 Q204,170 222,248 L230,248 L230,114Z" fill="#9C3540" opacity=".9" />
      <path d="M78,114 Q150,150 222,114" fill="none" stroke="#F7B538" stroke-width="6" stroke-dasharray="1 6" stroke-linecap="round" />
      <circle cx="150" cy="226" r="46" fill="url(#lm-halo)" />
      <path d="M150,198 C160,212 162,224 150,236 C138,224 140,212 150,198Z" fill="url(#lm-flame)" />
      <rect x="132" y="234" width="36" height="12" fill="url(#lm-brass)" />
      {strand(150, 8).map((b) => <circle cx={b.x} cy={b.y + 100} r="3.4" fill={b.c} />)}
      {[[40, 300], [260, 300], [100, 330], [200, 330]].map(([x, y]) => (
        <g transform={`translate(${x - 12} ${y}) scale(.4)`}><circle cx="30" cy="22" r="26" fill="url(#lm-halo)" /><path d="M30,6 C36,16 37,24 30,30 C23,24 24,16 30,6Z" fill="url(#lm-flame)" /><path d="M5,31 C10,46 50,46 55,31 C46,35 14,35 5,31Z" fill="url(#lm-brass)" /></g>
      ))}
    </>
  )}
  {key === 'haldi' && (
    <>
      <rect width="300" height="360" fill="url(#vg-haldi)" />
      <path d="M60,230 V120 Q60,70 150,56 Q240,70 240,120 V230Z" fill="#F7B538" opacity=".35" />
      <rect y="230" width="300" height="130" fill="#E9A85A" />
      <rect y="230" width="300" height="5" fill="#C9822E" />
      <line x1="0" y1="8" x2="300" y2="8" stroke="#7A5528" stroke-width="1.5" />
      {mangoLeaves.map((l) => <use href="#lm-leaf" fill="#3D7A3A" transform={`translate(${l.x} 8) rotate(${l.r}) scale(1.2)`} />)}
      {mangoLeaves.map((l) => <circle cx={l.x + 9} cy="10" r="4" fill="#F29A2E" />)}
      <ellipse cx="150" cy="300" rx="96" ry="28" fill="#FFF3E2" opacity=".55" />
      <ellipse cx="150" cy="300" rx="72" ry="20" fill="none" stroke="#E9822A" stroke-width="7" stroke-dasharray="2 8" stroke-linecap="round" />
      <ellipse cx="150" cy="300" rx="40" ry="11" fill="#F7B538" />
      <rect x="100" y="246" width="100" height="12" rx="2" fill="#9C3540" stroke="#F2D59A" stroke-width="1" />
      <rect x="106" y="258" width="6" height="12" fill="#7A2836" /><rect x="188" y="258" width="6" height="12" fill="#7A2836" />
      {[60, 240].map((x) => (
        <g>
          <ellipse cx={x} cy="300" rx="28" ry="10" fill="url(#lm-brass)" />
          <ellipse cx={x} cy="296" rx="22" ry="6" fill="#FFC24B" />
          <circle cx={x - 6} cy="295" r="3.5" fill="#E9822A" /><circle cx={x + 7} cy="297" r="3" fill="#F29A2E" />
        </g>
      ))}
    </>
  )}
  {key === 'mehndi' && (
    <>
      <rect width="300" height="360" fill="url(#vg-mehndi)" />
      {[30, 75, 120, 180, 225, 270].map((x, i) => (
        <g>
          <line x1={x} y1="0" x2={x} y2={50 + (i % 3) * 22} stroke="#C49A55" stroke-width="1" />
          {[0, 1, 2].map((k) => <circle cx={x} cy={18 + k * 14 + (i % 3) * 7} r="5" fill={['#E8648C', '#8DB35E', '#F7B538'][(k + i) % 3]} />)}
        </g>
      ))}
      <rect y="236" width="300" height="124" fill="#2A4134" />
      <ellipse cx="150" cy="282" rx="104" ry="36" fill="url(#lm-brass)" />
      <ellipse cx="150" cy="279" rx="94" ry="31" fill="#EAD6B7" />
      <g transform="translate(150 279) scale(1 .34)" fill="none" stroke="#7A3B1E" stroke-width="1.6">
        <circle r="8" fill="#7A3B1E" />
        {mandala.map((p) => <ellipse cx="0" cy={-p.rad} rx={3 + p.ring} ry={6 + p.ring * 2} transform={`rotate(${p.a})`} />)}
        <circle r="58" stroke-dasharray="2 4" />
        <circle r="70" />
      </g>
      <path d="M58,250 L74,214 L82,218 Z" fill="#3D5F49" /><path d="M74,214 l3,-5 l3,6 Z" fill="#7A3B1E" />
      <path d="M232,252 L218,216 L226,212 Z" fill="#3D5F49" /><path d="M218,216 l-1,-6 l5,4 Z" fill="#7A3B1E" />
      <rect x="6" y="300" width="58" height="34" rx="14" fill="#C8326B" /><rect x="236" y="300" width="58" height="34" rx="14" fill="#F7B538" />
      <circle cx="10" cy="334" r="4" fill="#F2D59A" /><circle cx="290" cy="334" r="4" fill="#9C3540" />
    </>
  )}
  {key === 'sangeet' && (
    <>
      <rect width="300" height="360" fill="url(#vg-night)" />
      <path d="M80,0 L30,250 L150,250 Z" fill="#FFE7AE" opacity=".12" />
      <path d="M220,0 L150,250 L270,250 Z" fill="#E8648C" opacity=".12" />
      <path d={'M8,26 ' + bulbs.map((b) => `L${b.x},${b.y}`).join(' ')} fill="none" stroke="#C49A55" stroke-width=".8" />
      {bulbs.map((b) => <circle cx={b.x} cy={b.y + 4} r="3.4" fill={b.c} filter="url(#lm-glow-small)" />)}
      <rect y="250" width="300" height="110" fill="#4B243E" />
      {[270, 292, 316, 342].map((y) => <line x1="0" y1={y} x2="300" y2={y} stroke="#252744" stroke-width="1" />)}
      <circle cx="150" cy="236" r="80" fill="url(#lm-halo)" opacity=".35" />
      <path d="M96,222 Q150,206 204,222 L204,262 Q150,278 96,262Z" fill="#9C3540" />
      <path d="M100,226 L120,258 L140,226 L160,258 L180,226 L200,258" fill="none" stroke="#F2D59A" stroke-width="1.6" />
      <ellipse cx="96" cy="242" rx="9" ry="20" fill="#EAD6B7" /><ellipse cx="204" cy="242" rx="9" ry="20" fill="#D9C2A0" />
      {[40, 260].map((x) => <g transform={`translate(${x - 12} 300) scale(.4)`} set:html={smallDiya} />)}
    </>
  )}
  {key === 'baraat' && (
    <>
      <rect width="300" height="360" fill="url(#vg-night)" />
      {bursts.map(([cx, cy, rad, c]) => (
        <g stroke={c} stroke-width="1.6" stroke-linecap="round" filter="url(#lm-glow-small)">
          {rays(cx, cy, rad).map((r) => <line x1={r.x1} y1={r.y1} x2={r.x2} y2={r.y2} />)}
        </g>
      ))}
      <use href="#lm-haveli" x="0" y="150" width="300" height="126" opacity=".55" />
      <rect y="272" width="300" height="88" fill="#2A2240" />
      <path d="M0,300 L300,286 L300,300 L0,316Z" fill="#3B2A40" />
      {walkers.map(([x, y, s]) => (
        <g transform={`translate(${x} ${y}) scale(${s})`}>
          <circle cy="-62" r="22" fill="url(#lm-halo)" />
          <path d="M-7,-58 L7,-58 L5,-50 L-5,-50Z" fill="#F2D59A" /><ellipse cy="-62" rx="6" ry="5" fill="#FFF3C4" />
          <circle cy="-42" r="6" fill="#2A1F33" />
          <path d="M-9,-35 L9,-35 L12,0 L-12,0Z" fill="#2A1F33" />
          <path d="M-9,-35 L-12,-56 M9,-35 L12,-56" stroke="#2A1F33" stroke-width="3" />
        </g>
      ))}
    </>
  )}
  {key === 'reception' && (
    <>
      <rect width="300" height="360" fill="url(#vg-rose)" />
      <path d="M58,268 V168 H242 V268 M76,168 V132 H224 V168" fill="none" stroke="#F2D59A" stroke-width="2" opacity=".7" />
      {archBlooms.map((b) => <use href="#lm-bloom" fill={b.c} transform={`translate(${b.x} ${b.y}) scale(.9)`} />)}
      <line x1="150" y1="0" x2="150" y2="44" stroke="#C49A55" stroke-width="1.2" />
      <circle cx="150" cy="64" r="44" fill="url(#lm-halo)" opacity=".7" />
      <ellipse cx="150" cy="52" rx="30" ry="6" fill="none" stroke="#F2D59A" stroke-width="2" />
      <ellipse cx="150" cy="70" rx="20" ry="4" fill="none" stroke="#F2D59A" stroke-width="2" />
      {drops.map((d) => <line x1={d.x} y1="54" x2={d.x} y2={d.y2} stroke="#FFF3E2" stroke-width="1.2" />)}
      <circle cx="150" cy="86" r="3" fill="#FFF3E2" />
      <rect y="280" width="300" height="80" fill="#8F5A6C" />
      <path d="M128,280 L172,280 L210,360 L90,360Z" fill="#9C3540" />
      <path d="M96,238 Q96,212 122,214 Q150,204 178,214 Q204,212 204,238 Z" fill="#FFF3E2" />
      <rect x="92" y="236" width="116" height="26" rx="6" fill="#EAD6B7" stroke="#C49A55" stroke-width="1.2" />
      <rect x="98" y="262" width="6" height="14" fill="#C49A55" /><rect x="196" y="262" width="6" height="14" fill="#C49A55" />
    </>
  )}
</svg>

<style>
  .vignette { width: 100%; height: 100%; }
</style>
