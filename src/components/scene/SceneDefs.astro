---
/** Shared SVG paint for the hero lantern and the bougainvillea fronds (scene/Foliage.astro). */
import { foliageMarkup } from '../../lib/art';
---
<svg class="scene-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="lm-brass-deep" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#E6C27B" /><stop offset=".5" stop-color="#B88945" /><stop offset="1" stop-color="#65401D" />
    </linearGradient>
    <linearGradient id="lm-brass" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F2D59A" />
      <stop offset=".5" stop-color="#C49A55" />
      <stop offset="1" stop-color="#7A5528" />
    </linearGradient>
    <linearGradient id="lm-flame" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FFFBEA" />
      <stop offset=".45" stop-color="#FFD66B" />
      <stop offset="1" stop-color="#F0782F" />
    </linearGradient>
    <radialGradient id="lm-halo">
      <stop offset="0" stop-color="#FFD98A" stop-opacity=".85" />
      <stop offset=".4" stop-color="#F7A94F" stop-opacity=".3" />
      <stop offset="1" stop-color="#F7A94F" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="lm-glass" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#F6A653" />
      <stop offset=".5" stop-color="#FFF0C4" />
      <stop offset="1" stop-color="#E88A44" />
    </linearGradient>
    <symbol id="lm-foliage-a" viewBox="-20 -20 440 400" overflow="visible" set:html={foliageMarkup(3)} />
    <symbol id="lm-foliage-b" viewBox="-20 -20 440 400" overflow="visible" set:html={foliageMarkup(11)} />
  </defs>
</svg>

<style>
  .scene-defs { position: absolute; width: 0; height: 0; overflow: hidden; }
</style>
