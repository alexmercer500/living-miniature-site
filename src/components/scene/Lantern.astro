---
/**
 * Hanging lantern. The SVG sits inside a plain wrapper so sway/scroll transforms
 * apply to an HTML box (composited) rather than repainting the SVG root each frame.
 */
interface Props { cord?: number; class?: string; style?: string }
const { cord = 40, class: cls = '', style } = Astro.props;
const h = cord + 100;
---
<span class:list={['lantern', cls]} style={style} aria-hidden="true">
  <svg viewBox={`0 0 60 ${h}`} focusable="false">
    <line x1="30" y1="0" x2="30" y2={cord} stroke="#C49A55" stroke-width="1.2" />
    <circle cx="30" cy={cord + 30} r="30" fill="url(#lm-halo)" class="lantern-halo" />
    <g transform={`translate(0 ${cord})`}>
      <path d="M22,0 H38 L46,12 H14 Z" fill="url(#lm-brass)" />
      <rect x="16" y="12" width="28" height="44" rx="5" fill="url(#lm-glass)" class="lantern-glass" />
      <path d="M23,12 V56 M30,12 V56 M37,12 V56" stroke="#9C6B2E" stroke-width="1.2" opacity=".75" />
      <path d="M14,56 H46 L40,64 H20 Z" fill="url(#lm-brass)" />
      <path d="M30,64 V74" stroke="#C49A55" stroke-width="1.2" />
      <path d="M26,74 H34 L32,92 H28 Z" fill="#9C3540" />
    </g>
  </svg>
</span>

<style>
  .lantern { display: block; }
  .lantern > svg { display: block; width: 100%; height: auto; overflow: visible; }
</style>
