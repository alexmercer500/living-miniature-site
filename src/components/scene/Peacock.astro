---
/**
 * A peacock resting at the water's edge (260×240 box, feet on y≈230).
 * Its train lies along the ground; `.is-fanned` raises it into a fan and turns the head.
 * Feather angles live in CSS custom properties so the change is a pure CSS transition.
 */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const N = 13;
const feathers = Array.from({ length: N }, (_, i) => {
  const t = i / (N - 1);
  return { rest: -70 - t * 38, fan: -78 + t * 156, len: 104 + Math.sin(Math.PI * t) * 22, d: Math.abs(i - (N - 1) / 2) };
});
---
<svg class:list={['peacock', cls]} viewBox="0 0 260 240" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="pc-body" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#2C6FB0" /><stop offset=".55" stop-color="#14558A" /><stop offset="1" stop-color="#0E6E7A" />
    </linearGradient>
    <linearGradient id="pc-feather" x1="0" y1="1" x2="0" y2="0">
      <stop offset="0" stop-color="#3F6A35" /><stop offset="1" stop-color="#8DB35E" />
    </linearGradient>
  </defs>

  <g class="train" transform="translate(122 176)">
    {feathers.map((f) => (
      <g class="feather" style={`--rest:${f.rest.toFixed(1)}deg; --fan:${f.fan.toFixed(1)}deg; --d:${f.d}`}>
        <path d={`M0,0 C-5,-${f.len * 0.4} -9,-${f.len * 0.8} 0,-${f.len} C9,-${f.len * 0.8} 5,-${f.len * 0.4} 0,0Z`} fill="url(#pc-feather)" opacity=".9" />
        <ellipse cy={-f.len + 11} rx="7.5" ry="9.5" fill="#7FB05A" />
        <ellipse cy={-f.len + 12} rx="5.6" ry="7" fill="#B8862E" />
        <ellipse cy={-f.len + 12.5} rx="3.8" ry="4.8" fill="#1F7A8C" />
        <ellipse cy={-f.len + 13} rx="2" ry="2.6" fill="#1B2F6B" />
      </g>
    ))}
  </g>

  <g stroke="#8A7A5A" stroke-width="2.4" stroke-linecap="round" fill="none">
    <path d="M150,186 L147,228 M147,228 l-7,2 M147,228 l6,2" />
    <path d="M160,186 L163,228 M163,228 l-6,2 M163,228 l7,2" />
  </g>
  <path d="M118,178 C120,150 150,128 172,138 C192,146 188,176 160,188 C142,194 122,191 118,178Z" fill="url(#pc-body)" />
  <path d="M128,172 C138,152 164,150 176,162 C166,178 144,184 128,172Z" fill="#8A6F4A" opacity=".85" />
  <path d="M132,170 C142,160 158,158 168,163" fill="none" stroke="#C9B48A" stroke-width=".8" stroke-dasharray="1.5 3" />
  <path d="M160,144 C164,120 160,100 166,84 C170,74 182,72 186,80 C188,90 178,100 176,118 C174,132 177,140 172,148Z" fill="url(#pc-body)" />

  <g class="pc-head">
    <circle cx="180" cy="78" r="9" fill="#1E4E8C" />
    <path d="M176,74 C180,71 186,72 188,76 C184,75 180,75 176,77Z" fill="#FFF3E2" />
    <circle cx="183" cy="76" r="1.5" fill="#17172C" />
    <path d="M188,77 L199,80.5 L188,84Z" fill="#C8B080" />
    <g stroke="#2E5E8C" stroke-width="1">
      <line x1="178" y1="70" x2="171" y2="52" /><line x1="179" y1="70" x2="178" y2="49" /><line x1="180" y1="70" x2="185" y2="52" />
    </g>
    <g fill="#2E9AAE"><circle cx="171" cy="51" r="2.3" /><circle cx="178" cy="48" r="2.3" /><circle cx="185" cy="51" r="2.3" /></g>
  </g>
</svg>

<style>
  .peacock { overflow: visible; }
  .feather {
    transform: rotate(var(--rest));
    transition: transform 0.9s var(--ease-out) calc(var(--d) * 30ms);
  }
  .pc-head { transform-origin: 180px 78px; transition: transform 0.45s var(--ease-out); }
  .peacock.is-fanned .feather { transform: rotate(var(--fan)); }
  .peacock.is-fanned .pc-head { transform: scaleX(-1); }
  .peacock.is-tappable { cursor: pointer; pointer-events: auto; -webkit-tap-highlight-color: transparent; }
  .peacock:focus-visible { outline: 2px solid var(--color-vermilion); outline-offset: 4px; border-radius: 8px; }
</style>
