---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import ActionBar from './ActionBar.astro';
import Hero from './sections/Hero.astro';
import Reveal from './sections/Reveal.astro';
import Envelope from './sections/Envelope.astro';
import Journey from './sections/Journey.astro';
import Celebrations from './sections/Celebrations.astro';
import Venue from './sections/Venue.astro';
import Rsvp from './sections/Rsvp.astro';
import Closing from './sections/Closing.astro';
import Intro from './Intro.astro';
import { type Lang, content, loc } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Base lang={lang} routePath="/royal">
  <Header lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <Reveal lang={lang} />
    <Envelope lang={lang} />
    <Journey lang={lang} />
    <Celebrations lang={lang} />
    <Venue lang={lang} />
    <Rsvp lang={lang} />
    <Closing lang={lang} />
  </main>
  <footer class="site-footer">
    <p>{loc(content.couple.displayName, lang)}</p>
  </footer>
  <ActionBar lang={lang} />
  <Intro lang={lang} />
</Base>

<script>
  import '../scripts/story';
  import { setupEnvelope } from '../scripts/envelope';
  setupEnvelope().catch((error) => console.warn('Invitation animation unavailable; the static card remains accessible.', error));
</script>

<style>
  .site-footer {
    padding: var(--space-5) var(--gutter) calc(var(--space-5) + env(safe-area-inset-bottom));
    text-align: center;
    font-size: var(--fs-small);
    color: var(--color-text-light-muted);
    background: var(--color-plum);
  }
</style>
