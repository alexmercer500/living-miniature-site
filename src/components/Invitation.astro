---
/**
 * The full invitation — deliberately separate from the cinematic journey.
 * Family names, invocation and host details live only here, as clearly marked placeholders
 * until approved copy is supplied.
 */
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Garland from './scene/Garland.astro';
import LotusMark from './LotusMark.astro';
import Monogram from './Monogram.astro';
import Icon from './Icon.astro';
import CalendarButton from './CalendarButton.astro';
import { type Lang, content, loc, t, href, formatDate, mapConfigured } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = content.invitation.placeholders;
const [one, two] = loc(content.couple.displayName, lang).split(lang === 'hi' ? ' एवं ' : ' & ');
const title = `${loc(content.invitation.label, lang)} — ${loc(content.couple.displayName, lang)}`;
---
<Base lang={lang} page="invitation" title={title}>
  <Header lang={lang} page="invitation" />
  <main id="main" class="invite-page">
    <Garland class="invite-toran" width={1400} strands={21} seed={9} />

    <article class="card" aria-labelledby="invite-title">
      <div class="card-inner">
        <LotusMark class="mark" />
        <p class="placeholder invocation">{loc(p.invocation, lang)}</p>
        <p class="placeholder">{loc(p.blessings, lang)}</p>

        <div class="ornament"><span></span></div>

        <h1 id="invite-title" class="names">
          <span>{one}</span>
          <span class="amp">{lang === 'hi' ? 'एवं' : '&'}</span>
          <span>{two}</span>
        </h1>
        <p class="tagline">{loc(content.couple.tagline, lang)}</p>

        <section class="block" aria-labelledby="families">
          <h2 id="families" class="eyebrow">{t(lang, 'fromFamilies')}</h2>
          <div class="families">
            <p class="placeholder">{loc(p.familyOne, lang)}</p>
            <p class="placeholder">{loc(p.familyTwo, lang)}</p>
          </div>
        </section>

        <section class="block" aria-labelledby="schedule">
          <h2 id="schedule" class="eyebrow">{t(lang, 'schedule')}</h2>
          <ol class="schedule">
            {content.events.map((e) => (
              <li>
                <h3>{loc(e.title, lang)}</h3>
                <p class="when">{formatDate(e.date, lang, true) ?? t(lang, 'dateTbc')}{e.time && <> · {e.time}</>}</p>
                <p class="where">{e.venueName}</p>
                <CalendarButton lang={lang} event={e} tone="dark" />
              </li>
            ))}
          </ol>
        </section>

        <section class="block" aria-labelledby="venue-h">
          <h2 id="venue-h" class="eyebrow">{t(lang, 'venueHeading')}</h2>
          <p class="venue-name">{content.venue.name}</p>
          <address>{content.venue.address}</address>
          {mapConfigured() && (
            <a class="text-link" href={content.venue.mapUrl} target="_blank" rel="noopener"><Icon name="pin" />{loc(content.venue.directionsLabel, lang)}</a>
          )}
        </section>

        <p class="placeholder">{loc(p.hosts, lang)}</p>

        <div class="ornament"><span></span></div>
        <Monogram class="card-mono" />
      </div>
    </article>

    <div class="page-actions">
      <button class="btn btn--solid" type="button" data-print hidden><Icon name="printer" />{t(lang, 'printInvitation')}</button>
      {content.invitation.downloadUrl && (
        <a class="btn btn--ghost-light" href={content.invitation.downloadUrl} download><Icon name="download" />{t(lang, 'downloadInvitation')}</a>
      )}
      <a class="btn btn--ghost-light" href={href(lang, '/')}>{t(lang, 'backToSite')}</a>
    </div>
  </main>
</Base>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-print]');
  if (btn) {
    btn.hidden = false;
    btn.addEventListener('click', () => window.print());
  }
</script>

<style>
  .invite-page {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-6);
    min-height: 100svh;
    padding: calc(var(--header-h) + var(--space-8)) var(--gutter) var(--space-8);
    background:
      radial-gradient(60% 40% at 50% 20%, rgb(169 88 96 / 0.35), transparent),
      linear-gradient(to bottom, var(--color-midnight), var(--color-plum));
  }
  .invite-page :global(.invite-toran) {
    position: absolute;
    top: var(--header-h);
    left: 0;
    width: 100%;
    height: clamp(110px, 14vw, 180px);
    pointer-events: none;
  }
  .card {
    position: relative;
    width: min(100%, 38rem);
    padding: clamp(0.5rem, 2vw, 0.875rem);
    background: var(--color-ivory);
    color: var(--color-text-dark);
    box-shadow: 0 30px 70px rgb(10 8 24 / 0.55);
  }
  .card-inner {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    padding: var(--space-7) clamp(1.25rem, 6vw, 3.5rem);
    text-align: center;
    border: 1px solid var(--color-antique-gold);
    outline: 1px solid rgb(196 154 85 / 0.5);
    outline-offset: -6px;
    background: radial-gradient(100% 60% at 50% 0%, #FFFAF2, transparent);
  }
  .card :global(.mark) { width: 3rem; color: var(--color-antique-gold); }
  .placeholder {
    max-width: 26rem;
    padding: var(--space-1) var(--space-3);
    font-size: var(--fs-small);
    font-style: italic;
    color: var(--color-text-dark-muted);
    background: rgb(234 214 183 / 0.45);
    border-radius: var(--radius-sm);
  }
  .invocation { font-family: var(--font-display); font-size: var(--fs-body); }
  .names {
    display: grid;
    font-size: clamp(2.5rem, 5vw + 1rem, 3.75rem);
    line-height: 1;
    color: var(--color-vermilion);
  }
  .names .amp { font-style: italic; font-size: 0.6em; line-height: 1.25; color: var(--color-antique-gold); }
  :lang(hi) .names { line-height: 1.3; }
  :lang(hi) .names .amp { font-style: normal; font-size: 0.5em; }
  .tagline { font-family: var(--font-display); font-style: italic; font-size: var(--fs-lead); color: var(--color-text-dark-muted); }
  :lang(hi) .tagline { font-style: normal; }

  .block {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    width: 100%;
    padding-top: var(--space-5);
    border-top: 1px solid rgb(196 154 85 / 0.35);
  }
  .block .eyebrow { color: var(--color-vermilion); }
  .families { display: grid; gap: var(--space-2); }
  .schedule { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); width: 100%; }
  .schedule h3 { font-size: var(--fs-h3); color: var(--color-text-dark); }
  .when { font-weight: 500; color: var(--color-vermilion); }
  .where, address { font-style: normal; color: var(--color-text-dark-muted); }
  .venue-name { font-family: var(--font-display); font-size: var(--fs-h3); }
  .text-link { display: inline-flex; align-items: center; gap: var(--space-2); min-height: var(--tap); color: var(--color-vermilion); }
  .text-link :global(svg) { width: 1.1rem; }
  .card :global(.card-mono) { font-size: 2.25rem; color: var(--color-antique-gold); }

  .page-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); }

  @media print {
    :global(.site-header), :global(.skip-link), .page-actions, .invite-page :global(.invite-toran) { display: none !important; }
    :global(html), :global(body) { background: #fff !important; }
    .invite-page { padding: 0; background: none; min-height: 0; }
    .card { box-shadow: none; width: 100%; }
  }
</style>
