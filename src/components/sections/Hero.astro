---
/**
 * Scene 1 — "A little world, a beautiful beginning".
 * A layered static poster (sky → sun → hills → palace → water → foreground → framing)
 * that paints with zero JS. Each layer carries data-layer so Milestone 2 can drive
 * parallax from scroll without restructuring markup.
 */
import { type Lang, content, loc, t } from '../../lib/content';
import Foliage from '../scene/Foliage.astro';
import Lantern from '../scene/Lantern.astro';
import Diya from '../scene/Diya.astro';
import Lotus from '../scene/Lotus.astro';
import LotusMark from '../LotusMark.astro';
import Icon from '../Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const [one, two] = loc(content.couple.displayName, lang).split(lang === 'hi' ? ' एवं ' : ' & ');
const amp = lang === 'hi' ? 'एवं' : '&';
---
<section id="welcome" class="hero" aria-labelledby="hero-title">
  <div class="stage" aria-hidden="true">
    <div class="sky" data-layer="sky"><div class="stars"></div></div>
    <div class="sun" data-layer="sun"></div>

    <svg class="hills" data-layer="hills" viewBox="0 0 1600 300" preserveAspectRatio="xMidYMax slice">
      <path d="M0,170 C120,120 220,150 320,112 S520,62 640,118 S860,168 980,104 S1200,46 1320,108 S1500,148 1600,96 V300 H0Z" fill="#9A5870" opacity=".55" />
      <path d="M0,232 C160,192 260,222 400,184 S650,204 800,218 S1050,172 1200,202 S1450,232 1600,192 V300 H0Z" fill="#6E3A57" />
      <g fill="#FFD98A" opacity=".75">
        <circle cx="1180" cy="206" r="1.4" /><circle cx="1214" cy="203" r="1.2" /><circle cx="1262" cy="210" r="1.4" /><circle cx="1330" cy="214" r="1.2" />
        <circle cx="214" cy="214" r="1.3" /><circle cx="262" cy="208" r="1.1" /><circle cx="330" cy="200" r="1.3" />
      </g>
      <rect y="250" width="1600" height="50" fill="url(#hero-mist)" />
      <defs>
        <linearGradient id="hero-mist" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#EAA17E" stop-opacity="0" />
          <stop offset="1" stop-color="#EAA17E" stop-opacity=".35" />
        </linearGradient>
      </defs>
    </svg>

    <svg class="palace" data-layer="palace" viewBox="0 0 1000 420"><use href="#lm-palace" /></svg>

    <div class="water" data-layer="water">
      <svg class="reflection" viewBox="0 0 1000 420"><use href="#lm-palace" /></svg>
      <div class="sun-glint"></div>
      <div class="ripples"></div>
    </div>

    <div class="foreground" data-layer="foreground">
      <Lotus class="lotus-left" />
      <Lotus class="lotus-right" blooms={1} />
      <Diya class="float-diya d1" />
      <Diya class="float-diya d2" />
      <Diya class="float-diya d3" />
    </div>

    <div class="frame" data-layer="frame">
      <Foliage side="left" class="foliage-hero" />
      <Foliage side="right" class="foliage-hero" />
      <Lantern class="hang l1" cord={70} />
      <Lantern class="hang l2" cord={20} />
      <Lantern class="hang l3" cord={44} />
    </div>

    <div class="petals">
      {Array.from({ length: 7 }, (_, i) => <i style={`--i:${i}`}></i>)}
    </div>
  </div>

  <div class="hero-copy">
    <LotusMark class="hero-mark" />
    <h1 id="hero-title" class="names">
      <span>{one}</span>
      <span class="amp">{amp}</span>
      <span>{two}</span>
    </h1>
    <p class="tagline">{loc(content.couple.tagline, lang)}</p>
  </div>

  <div class="hero-foot">
    <a class="scroll-cue" href="#reveal">
      <span class="cue-ring"><Icon name="arrow-down" /></span>
      <span class="eyebrow">{t(lang, 'scrollToBegin')}</span>
    </a>
    <a class="skip" href="#celebrations">{t(lang, 'skipIntro')}</a>
  </div>
  <span class="hero-end" data-hero-end></span>
</section>

<style>
  .hero {
    --horizon: 31%;
    --palace-w: clamp(520px, 152vw, 1080px);
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    isolation: isolate;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .hero { --horizon: 26%; --palace-w: min(74vw, 980px); }
  }
  @media (min-width: 1100px) {
    .hero { --horizon: 22%; --palace-w: min(60vw, 920px); }
  }
  @media (max-height: 700px) and (max-width: 767px) {
    .hero { --horizon: 22%; --palace-w: 460px; }
  }

  .stage { position: absolute; inset: 0; z-index: -1; }
  .stage > * { position: absolute; }

  .sky {
    inset: 0;
    background: linear-gradient(
      to bottom,
      var(--color-midnight) 0%,
      var(--color-indigo) 18%,
      var(--color-plum) 40%,
      var(--color-dusk-rose) 58%,
      var(--color-sunset) 68%,
      #F6C9A0 calc(100% - var(--horizon))
    );
  }
  .stars {
    position: absolute;
    inset: 0 0 55%;
    background-image:
      radial-gradient(1px 1px at 12% 18%, #fff8 50%, transparent),
      radial-gradient(1px 1px at 28% 8%, #fff9 50%, transparent),
      radial-gradient(1.5px 1.5px at 47% 14%, #fffb 50%, transparent),
      radial-gradient(1px 1px at 63% 6%, #fff8 50%, transparent),
      radial-gradient(1px 1px at 78% 20%, #fff7 50%, transparent),
      radial-gradient(1.5px 1.5px at 90% 10%, #fffa 50%, transparent),
      radial-gradient(1px 1px at 36% 30%, #fff5 50%, transparent),
      radial-gradient(1px 1px at 70% 34%, #fff5 50%, transparent);
    mask-image: linear-gradient(#000, transparent);
  }
  .sun {
    width: clamp(64px, 12vmin, 130px);
    aspect-ratio: 1;
    left: 72%;
    bottom: calc(var(--horizon) + clamp(18px, 4vw, 60px));
    border-radius: 50%;
    background: radial-gradient(circle, #FFF4D6 0 45%, #FFD9A0 60%, transparent 71%);
    box-shadow: 0 0 80px 40px rgb(255 205 150 / 0.35);
    translate: -50% 0;
  }
  .hills {
    left: 0;
    width: 100%;
    height: clamp(110px, 18vw, 240px);
    bottom: calc(var(--horizon) - 2px);
  }
  .palace {
    left: 50%;
    width: var(--palace-w);
    translate: -50% 0;
    bottom: calc(var(--horizon) - 3px);
    overflow: visible;
  }

  .water {
    inset: auto 0 0;
    height: var(--horizon);
    overflow: hidden;
    background: linear-gradient(to bottom, #7A4560 0%, #4B2E4D 30%, #2A2240 65%, var(--color-midnight) 100%);
  }
  .reflection {
    position: absolute;
    left: 50%;
    top: 0;
    width: var(--palace-w);
    translate: -50% 0;
    scale: 1 -1;
    transform-origin: top;
    opacity: 0.4;
    filter: blur(1.5px);
    mask-image: linear-gradient(to top, #000 0%, transparent 70%);
  }
  .sun-glint {
    position: absolute;
    left: 72%;
    top: 0;
    width: clamp(40px, 8vw, 90px);
    height: 70%;
    translate: -50% 0;
    background: repeating-linear-gradient(to bottom, rgb(255 226 180 / 0.55) 0 2px, transparent 2px 7px);
    mask-image: radial-gradient(50% 60% at 50% 0%, #000, transparent);
    opacity: 0.7;
  }
  .ripples {
    position: absolute;
    inset: -90px 0 0;
    background: repeating-linear-gradient(to bottom, rgb(255 220 190 / 0.06) 0 1px, transparent 1px 9px);
  }

  .foreground { inset: auto 0 0; height: var(--horizon); }
  .foreground :global(.lotus) { position: absolute; width: clamp(150px, 30vw, 300px); }
  .foreground :global(.lotus-left) { left: -4%; bottom: 6%; }
  .foreground :global(.lotus-right) { right: -6%; bottom: 22%; width: clamp(110px, 20vw, 220px); scale: -1 1; }
  .foreground :global(.float-diya) { position: absolute; width: clamp(34px, 6vw, 56px); }
  .foreground :global(.d1) { left: 12%; bottom: 52%; }
  .foreground :global(.d2) { left: 66%; bottom: 8%; width: clamp(42px, 7.5vw, 66px); }
  .foreground :global(.d3) { left: 80%; bottom: 46%; width: clamp(26px, 4.5vw, 42px); }

  .frame { inset: 0; pointer-events: none; }
  .frame :global(.foliage-hero) { width: clamp(180px, 40vw, 440px); }
  .frame :global(.lantern.hang) { position: absolute; top: 0; }
  .frame :global(.l1) { left: 11%; width: clamp(26px, 5vw, 46px); }
  .frame :global(.l2) { left: 25%; width: clamp(22px, 4vw, 38px); }
  .frame :global(.l3) { right: 13%; width: clamp(24px, 4.5vw, 42px); }

  .petals { inset: 0; overflow: hidden; pointer-events: none; }
  .petals i {
    position: absolute;
    top: -5%;
    left: calc(8% + var(--i) * 13%);
    width: 9px;
    height: 12px;
    border-radius: 80% 0 80% 0;
    background: linear-gradient(135deg, #E8648C, var(--color-vermilion));
    opacity: 0;
  }

  /* Copy */
  .hero-copy {
    position: relative;
    align-self: start;
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    padding: calc(var(--header-h) + clamp(1.5rem, 7svh, 4.5rem)) var(--gutter) 0;
    text-align: center;
    color: var(--color-text-light);
    pointer-events: none;
  }
  .hero-copy::before {
    content: '';
    position: absolute;
    inset: 10% -10% -20%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(23 23 44 / 0.45), transparent);
  }
  .hero-copy :global(.hero-mark) { width: 3.25rem; color: var(--color-gold-highlight); }
  .names {
    display: grid;
    font-size: var(--fs-names);
    font-weight: 500;
    line-height: 0.98;
    text-shadow: 0 2px 24px rgb(23 23 44 / 0.55);
  }
  .names .amp {
    font-style: italic;
    font-size: 0.62em;
    line-height: 1.2;
    color: var(--color-gold-highlight);
  }
  :lang(hi) .names { line-height: 1.25; }
  :lang(hi) .names .amp { font-style: normal; font-size: 0.5em; }
  @media (min-width: 1100px) {
    .names { display: block; }
    .names span { display: inline; }
    .names .amp { padding: 0 0.25em; }
  }
  .tagline {
    max-width: 22rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-lead);
    color: var(--color-text-light-muted);
    text-shadow: 0 1px 12px rgb(23 23 44 / 0.8);
  }
  :lang(hi) .tagline { font-style: normal; }

  .hero-foot {
    pointer-events: none;
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    padding: 0 var(--gutter) max(var(--space-5), env(safe-area-inset-bottom));
  }
  .hero-foot > * { pointer-events: auto; }
  .scroll-cue {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    padding: var(--space-2);
    text-decoration: none;
    color: var(--color-text-light);
  }
  .cue-ring {
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border: 1px solid var(--color-line-gold);
    border-radius: 50%;
    background: rgb(23 23 44 / 0.35);
  }
  .cue-ring :global(svg) { width: 1.1rem; color: var(--color-gold-highlight); }
  .skip {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--space-3);
    font-size: var(--fs-small);
    color: var(--color-text-light-muted);
    text-underline-offset: 4px;
    text-decoration-color: var(--color-line-gold);
  }
  .hero-end { position: absolute; bottom: 0; height: 1px; width: 1px; }

  /* Ambient life — only when motion is welcome */
  @media (prefers-reduced-motion: no-preference) {
    .frame :global(.lantern.hang) { transform-origin: 50% 0; will-change: transform; animation: sway 6s var(--ease-in-out) infinite alternate; }
    .frame :global(.l2) { animation-duration: 7.5s; animation-delay: -2s; }
    .frame :global(.l3) { animation-duration: 6.8s; animation-delay: -4s; }
    .stage :global(.diya-flame) { animation: flicker 2.4s ease-in-out infinite; }
    .stage :global(.diya-halo) { animation: breathe 3.2s ease-in-out infinite; }
    .foreground :global(.float-diya) { animation: bob 5s ease-in-out infinite alternate; }
    .foreground :global(.d2) { animation-delay: -1.7s; }
    .foreground :global(.d3) { animation-delay: -3.1s; }
    .ripples { will-change: transform; animation: drift 14s linear infinite; }
    .petals i { animation: fall calc(13s + var(--i) * 1.7s) linear infinite; animation-delay: calc(var(--i) * -2.3s); }
    .cue-ring { animation: nudge 2.4s var(--ease-in-out) infinite; }
  }
  @keyframes sway { from { rotate: -2.5deg; } to { rotate: 2.5deg; } }
  @keyframes flicker { 0%, 100% { scale: 1 1; } 30% { scale: 0.94 1.06; } 60% { scale: 1.04 0.95; } }
  @keyframes breathe { 0%, 100% { opacity: 0.85; } 50% { opacity: 1; } }
  @keyframes bob { from { translate: 0 0; } to { translate: 3px -4px; } }
  @keyframes drift { to { transform: translateY(90px); } }
  @keyframes nudge { 0%, 100% { translate: 0 0; } 50% { translate: 0 5px; } }
  @keyframes fall {
    0% { opacity: 0; transform: translate(0, 0) rotate(0); }
    10% { opacity: 0.85; }
    85% { opacity: 0.7; }
    100% { opacity: 0; transform: translate(-18vw, 105svh) rotate(540deg); }
  }
</style>
