---
/**
 * Scene 7 — countdown & RSVP. Each part renders only when configured:
 * the countdown needs a real `site.weddingDate`, the button needs `rsvp.enabled` + `rsvp.url`.
 */
import { type Lang, content, loc, t, parseDate, rsvpConfigured } from '../../lib/content';
import Lantern from '../scene/Lantern.astro';
import Icon from '../Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const date = parseDate(content.site.weddingDate);
const hasRsvp = rsvpConfigured();
const units = ['days', 'hours', 'minutes', 'seconds'] as const;
---
{(date || hasRsvp) ? (
  <section id="rsvp" class="rsvp" aria-labelledby="rsvp-title">
    <div class="sky-lanterns" aria-hidden="true">
      {Array.from({ length: 6 }, (_, i) => <Lantern cord={0} style={`--i:${i}; top:${12 + ((i * 37) % 60)}%`} />)}
    </div>
    <h2 id="rsvp-title">{t(lang, 'countdownHeading')}</h2>
    {date && (
      <div class="countdown" data-countdown={date.toISOString()} role="timer" aria-live="off">
        {units.map((u) => (
          <div class="unit"><span class="num" data-unit={u}>–</span><span class="label">{t(lang, u)}</span></div>
        ))}
      </div>
    )}
    <div class="ornament"><span></span></div>
    {hasRsvp && (
      <a class="btn btn--solid rsvp-btn" href={content.rsvp.url} target="_blank" rel="noopener">
        <Icon name="heart" />{loc(content.rsvp.label, lang)}
      </a>
    )}
  </section>
) : import.meta.env.DEV && (
  <p class="dev-note rsvp-dev">Dev only: set a real <code>site.weddingDate</code> (YYYY-MM-DD) for the countdown, and <code>rsvp.enabled</code> + <code>rsvp.url</code> for the RSVP button.</p>
)}

<script>
  const el = document.querySelector<HTMLElement>('[data-countdown]');
  if (el) {
    const target = new Date(el.dataset.countdown!).getTime();
    const nums = Object.fromEntries([...el.querySelectorAll<HTMLElement>('[data-unit]')].map((n) => [n.dataset.unit, n]));
    let timer = 0;
    const tick = () => {
      const ms = Math.max(0, target - Date.now());
      const parts = { days: Math.floor(ms / 864e5), hours: Math.floor(ms / 36e5) % 24, minutes: Math.floor(ms / 6e4) % 60, seconds: Math.floor(ms / 1e3) % 60 };
      for (const [k, v] of Object.entries(parts)) if (nums[k]) nums[k].textContent = String(v).padStart(2, '0');
      if (ms === 0) clearInterval(timer);
    };
    tick();
    // Only tick while visible and the tab is active.
    const start = () => { if (!timer) timer = window.setInterval(tick, 1000); };
    const stop = () => { clearInterval(timer); timer = 0; };
    new IntersectionObserver(([e]) => (e.isIntersecting && !document.hidden ? start() : stop())).observe(el);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : tick()));
  }
</script>

<style>
  .rsvp {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    padding: var(--space-9) var(--gutter);
    text-align: center;
    background: linear-gradient(to bottom, var(--color-midnight), var(--color-indigo) 60%, var(--color-plum));
    overflow: hidden;
    isolation: isolate;
  }
  .rsvp h2 { font-size: var(--fs-h2); }
  .sky-lanterns { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .sky-lanterns :global(.lantern) {
    position: absolute;
    width: 22px;
    left: calc(6% + var(--i) * 16%);
    opacity: 0.7;
  }
  .countdown { display: flex; gap: var(--space-3); }
  .unit {
    display: grid;
    min-width: 4.25rem;
    padding: var(--space-3) var(--space-2);
    border: 1px solid var(--color-line-gold);
    background: rgb(23 23 44 / 0.5);
  }
  .num { font-family: var(--font-display); font-size: 2.25rem; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .label { font-size: var(--fs-eyebrow); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-light-muted); }
  :lang(hi) .label { font-size: var(--fs-small); letter-spacing: 0; text-transform: none; }
  .rsvp-dev { margin: var(--space-6) auto; color: var(--color-text-light-muted); }
  @media (max-width: 359px) { .unit { min-width: 3.5rem; } .num { font-size: 1.75rem; } }
  @media (prefers-reduced-motion: no-preference) {
    .sky-lanterns :global(.lantern) { animation: rise calc(18s + var(--i) * 3s) ease-in-out infinite alternate; }
  }
  @keyframes rise { to { translate: 6px -40px; } }
</style>
