---
/** Scene 6 — venue reveal. Details are real HTML beside the art, never inside it. */
import { type Lang, content, loc, t, mapConfigured } from '../../lib/content';
import Lantern from '../scene/Lantern.astro';
import Icon from '../Icon.astro';
import { getImage } from 'astro:assets';
import mobileVenue from '../../assets/royal-heritage/venue-mobile-v1.png';
import desktopVenue from '../../assets/royal-heritage/venue-desktop-v1.png';
const sources = await Promise.all(['avif', 'webp'].map(async (format) => {
  const variants = async (src: typeof mobileVenue, widths: number[]) =>
    (await Promise.all(widths.map(async (width) => {
      const image = await getImage({ src, width, format: format as 'avif' | 'webp', quality: format === 'avif' ? 55 : 76 });
      return `${image.src} ${width}w`;
    }))).join(', ');
  return { type: `image/${format}`, mobile: await variants(mobileVenue, [480, 768, 1024]), desktop: await variants(desktopVenue, [1280, 1672]) };
}));
const fallback = await getImage({ src: mobileVenue, width: 768, format: 'webp', quality: 76 });
const staticDesktop = await getImage({ src: desktopVenue, width: 1280, format: 'webp', quality: 76 });
interface Props { lang: Lang }
const { lang } = Astro.props;
const hasMap = mapConfigured();
---
<section id="venue" class="venue" aria-labelledby="venue-title">
  <div class="venue-art" aria-hidden="true">
    <div class="v-sky"></div>
    <svg class="v-palace v-haveli" viewBox="0 0 1000 420"><use href="#lm-haveli" /></svg>
    <div class="v-water"><svg class="v-reflection" viewBox="0 0 1000 420"><use href="#lm-haveli" /></svg></div>
    <div class="v-lanterns">
      <Lantern cord={10} /><Lantern cord={46} /><Lantern cord={24} /><Lantern cord={60} /><Lantern cord={18} />
    </div>
    <!-- SVG layers remain underneath for loading, image errors and static delivery. -->
    <picture class="venue-poster" data-venue-poster>
      {sources.map((source) => <>
        <source media="(min-width: 768px) and (min-aspect-ratio: 1/1)" type={source.type} srcset={source.desktop} sizes="100vw" />
        <source type={source.type} srcset={source.mobile} sizes="100vw" />
      </>)}
      <img src={fallback.src} width={mobileVenue.width} height={mobileVenue.height} alt="" loading="lazy" decoding="async" data-venue-image />
    </picture>
    <noscript>
      <!-- A failed CSS background is transparent, unlike a native broken img box. -->
      <div class="venue-static" style={`--static-mobile: url('${fallback.src}'); --static-desktop: url('${staticDesktop.src}')`}></div>
    </noscript>
    <div class="venue-shade"></div>
  </div>

  <div class="venue-card">
    <span class="pin"><Icon name="pin" /></span>
    <p class="eyebrow">{t(lang, 'venueHeading')}</p>
    <h2 id="venue-title">{content.venue.name}</h2>
    <address>{content.venue.address}</address>
    {hasMap ? (
      <div class="actions">
        <a class="btn btn--solid" href={content.venue.mapUrl} target="_blank" rel="noopener">
          <Icon name="pin" />{loc(content.venue.directionsLabel, lang)}
        </a>
        <a class="btn btn--ghost-light" href={content.venue.mapUrl} target="_blank" rel="noopener">{t(lang, 'viewMap')}</a>
      </div>
    ) : import.meta.env.DEV && (
      <p class="dev-note">Dev only: set <code>venue.mapUrl</code> to show “View map / Get directions”.</p>
    )}
  </div>
</section>

<script>
  const image = document.querySelector<HTMLImageElement>('[data-venue-image]');
  const update = () => image?.closest('picture')?.toggleAttribute('data-art-failed', image.complete && image.naturalWidth === 0);
  image?.addEventListener('error', () => image.closest('picture')?.setAttribute('data-art-failed', ''));
  image?.addEventListener('load', update);
  if (image?.complete) update();
</script>

<style>
  .venue {
    position: relative;
    display: grid;
    background: #21140f;
  }
  .venue-art {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
  }
  .venue-art > * { position: absolute; }
  .venue-art > noscript { inset: 0; }
  .venue-poster { inset: 0; z-index: 1; }
  .venue-poster img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .venue-poster[data-art-failed] { display: none; }
  .venue-static { position: absolute; inset: 0; z-index: 1; background: var(--static-mobile) center / cover no-repeat; }
  @media (scripting: none) { .venue-poster { display: none; } }
  .venue-shade { inset: 0; z-index: 2; pointer-events: none; background: linear-gradient(#21140f33, transparent 12% 83%, #21140f); }
  @media (min-width: 768px) and (min-aspect-ratio: 1/1) {
    .venue-art { aspect-ratio: 1672 / 941; }
    .venue-static { background-image: var(--static-desktop); }
  }
  .v-sky {
    inset: 0;
    background:
      radial-gradient(50% 40% at 50% 70%, rgb(230 194 123 / 0.25), transparent),
      linear-gradient(to bottom, var(--color-midnight), var(--color-indigo) 35%, var(--color-plum) 62%, var(--color-dusk-rose) 72%);
  }
  .v-palace {
    left: 50%;
    bottom: 26%;
    width: clamp(460px, 120vw, 820px);
    translate: -50% 0;
    overflow: visible;
    filter: saturate(0.9) brightness(0.92);
  }
  .v-water {
    inset: auto 0 0;
    height: 26%;
    overflow: hidden;
    background: linear-gradient(to bottom, #5A2F2C, var(--color-midnight));
  }
  .v-reflection {
    position: absolute;
    left: 50%;
    top: 0;
    width: clamp(460px, 120vw, 820px);
    translate: -50% 0;
    scale: 1 -1;
    transform-origin: top;
    opacity: 0.35;
    filter: blur(2px);
    mask-image: linear-gradient(to top, #000, transparent 75%);
  }
  .v-lanterns {
    inset: 0 0 auto;
    display: flex;
    justify-content: space-around;
    padding-inline: 4%;
  }
  .v-lanterns :global(.lantern) { width: clamp(22px, 4vw, 40px); height: auto; }

  .venue-card {
    position: relative;
    z-index: 3;
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    width: min(100% - 2 * var(--gutter), 34rem);
    margin: -1.5rem auto var(--space-8);
    padding: var(--space-7) clamp(1rem, 5vw, 2.5rem) var(--space-6);
    text-align: center;
    background: linear-gradient(145deg, #4b1020, #291618 65%, #21140f);
    border: 1px solid var(--color-line-gold);
    border-radius: 2px;
    box-shadow: 0 20px 50px rgb(0 0 0 / 0.4);
  }
  .pin {
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: #321b20;
    border: 1px solid var(--color-antique-gold);
    color: var(--color-gold-highlight);
  }
  .pin :global(svg) { width: 1.4rem; }
  .eyebrow { color: var(--color-antique-gold); }
  h2 { font-size: var(--fs-h2); }
  address { font-style: normal; color: var(--color-text-light-muted); max-width: 26rem; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); margin-top: var(--space-3); }
  .dev-note { margin-top: var(--space-3); color: var(--color-text-light-muted); }
</style>
