---
/** Scene 2 + 3 — the gateway opens onto an ivory jharokha carrying the couple's names. */
import { type Lang, content, loc, href, formatDate } from '../../lib/content';
import ArchFrame from '../scene/ArchFrame.astro';
import Garland from '../scene/Garland.astro';
import Foliage from '../scene/Foliage.astro';
import Diya from '../scene/Diya.astro';
import Gate from '../scene/Gate.astro';
import LotusMark from '../LotusMark.astro';
import Icon from '../Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const [one, two] = loc(content.couple.displayName, lang).split(lang === 'hi' ? ' एवं ' : ' & ');
const date = formatDate(content.site.weddingDate, lang, true) ?? loc(content.site.weddingDateLabel, lang);
---
<section id="reveal" class="reveal" aria-labelledby="reveal-title">
  <div class="backdrop" aria-hidden="true">
    <Garland class="toran" width={1400} strands={21} />
    <Foliage side="left" variant="b" class="reveal-foliage" />
    <Foliage side="right" variant="a" class="reveal-foliage" />
  </div>

  <ArchFrame class="panel">
    <div class="panel-copy" data-reveal-copy>
      <LotusMark class="mark" />
      <h2 id="reveal-title" class="names">
        <span>{one}</span>
        <span class="amp">{lang === 'hi' ? 'एवं' : '&'}</span>
        <span>{two}</span>
      </h2>
      <div class="ornament"><span></span></div>
      <p class="date">{date}</p>
      <a class="btn btn--ghost-dark" href={href(lang, '/invitation')}>
        {loc(content.invitation.label, lang)} <Icon name="arrow-right" />
      </a>
    </div>
    <Gate slot="over" lang={lang} />
  </ArchFrame>

  <div class="sill" aria-hidden="true">
    <Diya class="sill-diya" /><Diya class="sill-diya" /><Diya class="sill-diya" />
  </div>
</section>

<style>
  .reveal {
    position: relative;
    display: grid;
    justify-items: center;
    padding: clamp(7rem, 18vw, 10rem) var(--gutter) var(--space-8);
    background:
      radial-gradient(60% 45% at 50% 55%, rgb(234 161 126 / 0.28), transparent 70%),
      linear-gradient(to bottom, var(--color-midnight), var(--color-plum) 55%, #5E2C48);
    overflow: hidden;
    isolation: isolate;
  }
  .backdrop { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .backdrop :global(.toran) { position: absolute; top: 0; left: 0; width: 100%; height: clamp(130px, 16vw, 210px); }
  .backdrop :global(.reveal-foliage) { top: auto; bottom: -4%; width: clamp(160px, 34vw, 380px); rotate: 180deg; }
  .backdrop :global(.foliage--left.reveal-foliage) { scale: -1 1; }
  .backdrop :global(.foliage--right.reveal-foliage) { scale: 1 1; }

  .reveal :global(.panel) {
    width: min(100%, 30rem);
    aspect-ratio: 5 / 7;
    min-height: 30rem;
    filter: drop-shadow(0 30px 60px rgb(10 8 24 / 0.55));
  }
  .panel-copy {
    height: 100%;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--space-4);
    padding: 26% 12% 12%;
    text-align: center;
    color: var(--color-text-dark);
  }
  .panel-copy :global(.mark) { width: 3rem; color: var(--color-antique-gold); }
  .names {
    display: grid;
    font-size: clamp(2.5rem, 6vw + 1rem, 4rem);
    line-height: 1;
    color: var(--color-vermilion);
  }
  .names .amp { font-style: italic; font-size: 0.6em; line-height: 1.25; color: var(--color-antique-gold); }
  :lang(hi) .names { line-height: 1.3; }
  :lang(hi) .names .amp { font-style: normal; font-size: 0.5em; }
  .date {
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    color: var(--color-text-dark-muted);
  }
  .panel-copy .btn { margin-top: var(--space-2); }

  .sill {
    display: flex;
    gap: clamp(2rem, 8vw, 4rem);
    margin-top: calc(var(--space-5) * -1);
  }
  .sill :global(.sill-diya) { width: clamp(40px, 9vw, 56px); }
  .sill :global(.sill-diya:nth-child(2)) { width: clamp(48px, 11vw, 68px); translate: 0 6px; }

  @media (prefers-reduced-motion: no-preference) {
    .sill :global(.diya-flame) { animation: flicker 2.6s ease-in-out infinite; }
    .sill :global(.sill-diya:nth-child(2) .diya-flame) { animation-delay: -1s; }
  }
  @keyframes flicker { 0%, 100% { scale: 1 1; } 30% { scale: 0.94 1.06; } 60% { scale: 1.04 0.95; } }
</style>
