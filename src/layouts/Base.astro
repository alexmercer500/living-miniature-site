---
// Per-weight files carry unicode-range for every subset, so a page only downloads the
// scripts it actually renders (the per-subset files claim all characters and load everything).
import '@fontsource-variable/fraunces/soft.css';
import '@fontsource-variable/fraunces/soft-italic.css';
import '@fontsource-variable/jost/wght.css';
import '@fontsource/great-vibes/400.css';
import '@fontsource/mukta/400.css';
import '@fontsource/mukta/500.css';
import '@fontsource/tiro-devanagari-hindi/400.css';
import '../styles/global.css';
import '../styles/rajasthan.css';
import SceneDefs from '../components/scene/SceneDefs.astro';
// The faces the welcome names use, fetched with the HTML rather than after layout discovers them.
// (Same files the fontsource CSS points at, so the browser downloads each only once.)
import fraunces from '../../node_modules/@fontsource-variable/fraunces/files/fraunces-latin-soft-normal.woff2?url';
import jost from '../../node_modules/@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';
import greatVibes from '../../node_modules/@fontsource/great-vibes/files/great-vibes-latin-400-normal.woff2?url';
import tiro from '../../node_modules/@fontsource/tiro-devanagari-hindi/files/tiro-devanagari-hindi-devanagari-400-normal.woff2?url';
import muktaDevanagari from '../../node_modules/@fontsource/mukta/files/mukta-devanagari-400-normal.woff2?url';
import { getImage } from 'astro:assets';
import { type Lang, content, loc, t, href } from '../lib/content';
import { coupleDisplay, themeConfig, themeRoute, type ThemeId } from '../lib/theme';

interface Props { lang: Lang; title?: string; description?: string; page?: 'home' | 'invitation'; routePath?: string; theme?: ThemeId }
const requestedTheme = Astro.props.theme as ThemeId | undefined;
const theme = requestedTheme ?? (Astro.url.pathname.includes('/amber-fort') ? 'amber-fort' : (Astro.url.pathname.includes('/lake-city') || Astro.url.pathname.includes('/lake-view')) ? 'lake-city' : 'nature');
const { lang, page = 'home' } = Astro.props;
const themeMeta = themeConfig[theme];
const socialMeta = themeMeta.meta[lang];
// The deployment's own theme is served at the root, so its canonical link is the bare domain.
const route = themeRoute(theme);
const invitationPath = route === '/' ? '/invitation' : `${route}/invitation`;
const title = Astro.props.title ?? (page === 'invitation' ? `${coupleDisplay(lang, theme)} — ${t(lang, 'weddingInvitation')}` : socialMeta.title);
const description = Astro.props.description ?? socialMeta.description;
const suppliedPath = Astro.props.routePath as string | undefined;
const path = suppliedPath && (suppliedPath !== '/' && !(page === 'invitation' && theme !== 'nature' && suppliedPath === '/invitation'))
  ? suppliedPath
  : (page === 'invitation' ? invitationPath : route);
const canonical = new URL(href(lang, path), Astro.site);
// Link preview (WhatsApp, Messages, social): the theme's invitation card at the 1.91:1 size they
// expect (scripts/render-og-cards.mjs), falling back to the welcome painting alone.
const cards = import.meta.glob<ImageMetadata>('../assets/og/*.jpg', { eager: true, import: 'default' });
const card = cards[`../assets/og/${theme}-${lang}.jpg`] ?? themeMeta.assets.hero.desktop;
const preview = await getImage({ src: card, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 84 });
const preloads = lang === 'hi' ? [tiro, muktaDevanagari] : [fraunces, jost, greatVibes];
---
<!doctype html>
<html lang={lang} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Guests get the link directly; the pages carry home addresses and family names, so search
         engines are asked to leave them out. Link previews are unaffected. -->
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content={themeMeta.themeColor} />
    {preloads.map(font => <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(href('en', path), Astro.site)} />
    <link rel="alternate" hreflang="hi" href={new URL(href('hi', path), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(href('en', path), Astro.site)} />
    <meta property="og:site_name" content={socialMeta.title} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'hi' ? 'hi_IN' : 'en_IN'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(preview.src, Astro.site)} />
    <meta property="og:image:url" content={new URL(preview.src, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={coupleDisplay(lang, theme)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(preview.src, Astro.site)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'skipToContent')}</a>
    <SceneDefs />
    <slot />
  </body>
</html>
