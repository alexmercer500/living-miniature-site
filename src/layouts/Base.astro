---
// Per-weight files carry unicode-range for every subset, so a page only downloads the
// scripts it actually renders (the per-subset files claim all characters and load everything).
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/mukta/400.css';
import '@fontsource/mukta/500.css';
import '@fontsource/tiro-devanagari-hindi/400.css';
import '../styles/global.css';
import SceneDefs from '../components/scene/SceneDefs.astro';
import { type Lang, content, loc, t, href } from '../lib/content';

interface Props { lang: Lang; title?: string; description?: string; page?: 'home' | 'invitation'; routePath?: string; theme?: 'nature' }
const { lang, page = 'home' } = Astro.props;
const title = Astro.props.title ?? (lang === 'hi' ? `${loc(content.couple.displayName, 'hi')} — विवाह उत्सव` : content.site.title);
const description = Astro.props.description ?? (lang === 'hi' ? loc(content.couple.tagline, 'hi') : content.site.description);
const path = Astro.props.routePath ?? (page === 'invitation' ? '/invitation' : '/');
const canonical = new URL(href(lang, path), Astro.site);
---
<!doctype html>
<html lang={lang} data-theme={Astro.props.theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={Astro.props.theme === 'nature' ? '#213B32' : '#17172C'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(href('en', path), Astro.site)} />
    <link rel="alternate" hreflang="hi" href={new URL(href('hi', path), Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'hi' ? 'hi_IN' : 'en_IN'} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'skipToContent')}</a>
    <SceneDefs />
    <slot />
  </body>
</html>
